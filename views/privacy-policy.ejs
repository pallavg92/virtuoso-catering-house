<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
<%- include('partials/head') %>
</head>
<body class="<%= bodyClass %>">

<%- include('partials/preloader') %>
<%- include('partials/cursor') %>
<%- include('partials/nav') %>
<%- include('partials/whatsapp-float') %>
<%- include('partials/popups') %>

<main id="smooth-wrapper">
<div id="smooth-content">

  <!-- INTRO -->
  <section class="page-intro page-intro--short">
    <div class="page-intro__media" data-parallax>
      <img src="<%= heroImage %>" alt="Virtuoso Catering House" loading="eager">
    </div>
    <div class="page-intro__scrim"></div>
    <div class="page-intro__content container">
      <%- include('partials/breadcrumb') %>
      <span class="eyebrow eyebrow--light reveal-up">Legal</span>
      <h1 class="page-intro__title reveal-up">Privacy<br>Policy</h1>
    </div>
  </section>

  <!-- POLICY -->
  <section class="blog-post section section--ivory">
    <div class="container">
      <div class="blog-post__prose">
        <p class="blog-post__copy blog-post__copy--lead reveal-up"><%= privacyPolicy.intro %></p>
        <p class="blog-post__copy reveal-up"><em>Last updated <%= privacyPolicy.updated %>.</em></p>
      </div>

      <% privacyPolicy.sections.forEach(function(section) { %>
      <div class="blog-post__prose">
        <h2 class="blog-post__heading reveal-up"><%= section.heading %></h2>
        <% (section.paragraphs || []).forEach(function(p) { %>
        <p class="blog-post__copy reveal-up"><%= p %></p>
        <% }); %>
        <% if (section.list && section.list.length) { %>
        <ul class="landing-list">
          <% section.list.forEach(function(item) { %>
          <li class="landing-list__item reveal-up"><%= item %></li>
          <% }); %>
        </ul>
        <% } %>
      </div>
      <% }); %>
    </div>
  </section>

<%- include('partials/footer') %>
</div>
</main>

<%- include('partials/scripts') %>
</body>
</html>
