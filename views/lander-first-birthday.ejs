<title>First birthdays in Delhi NCR — Virtuoso Catering House</title>
<meta name="description" content="For first-birthday celebrations of 50 guests or more in Delhi NCR, Virtuoso brings menu, live experiences, presentation and service together as one personalised F&amp;B experience." />
<meta name="robots" content="noindex" /><!-- paid traffic lander: remove if this page should be indexed -->

<!-- Hero preload. The hero is a CSS background-image on .hero-overlay, so the
     browser cannot discover it until it has downloaded and parsed the stylesheet,
     which on this page meant the largest element did not arrive until ~7s on
     mobile while first paint happened at 1.1s. Preloading the exact URL the CSS
     requests starts the fetch immediately without causing a second download. -->
<link rel="preload" as="image" href="/img/hero-first-birthday.jpg" fetchpriority="high" />

<!-- Analytics, queued immediately and fetched late.
     The stubs below run at once, so fbq('init'), fbq('track') and every gtag()
     call are captured into their queues in the normal order. Only the two
     vendor script files are deferred, and they replay the queue on arrival, so
     nothing is dropped: a PageView still reports, and the lead events on the
     thank-you page still fire with their event_id.
     Why: on this lander the three tracking files total ~394KB, four times the
     weight of the hero image, and they were competing with it for the network
     during first paint. This is paid traffic, so every second of delay is money.
     Loads on whichever comes first: page load plus a short delay, or the first
     real interaction. A visitor who leaves inside ~2s may not register a
     PageView, which is the accepted trade for the pages actually rendering. -->
<script>
(function () {
  // Meta stub. Queues calls exactly as the official snippet does.
  !function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?
  n.callMethod.apply(n,arguments):n.queue.push(arguments)};
  if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
  n.queue=[]}(window, document,'script');

  // GA4 stub. dataLayer preserves ordering until gtag.js arrives.
  window.dataLayer = window.dataLayer || [];
  window.gtag = function(){ dataLayer.push(arguments); };

  // Only report from the live domain. Without this guard, local dev and
  // staging traffic lands in the same dataset as real visitors and skews
  // both the audience pool and the conversion counts.
  var live = /(^|\.)virtuosocatering\.com$/.test(location.hostname);
  if (live) {
    fbq('init', '1747975173071768');
    fbq('track', 'PageView');
  }
  gtag('js', new Date());
  gtag('config', 'G-7D4B5HCKXQ');

  var loaded = false;
  function loadVendors() {
    if (loaded || !live) return;
    loaded = true;
    ['https://connect.facebook.net/en_US/fbevents.js',
     'https://www.googletagmanager.com/gtag/js?id=G-7D4B5HCKXQ'].forEach(function (src) {
      var t = document.createElement('script');
      t.async = true; t.src = src;
      document.head.appendChild(t);
    });
  }

  // Whichever happens first.
  ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (evt) {
    window.addEventListener(evt, loadVendors, { once: true, passive: true });
  });
  if (document.readyState === 'complete') setTimeout(loadVendors, 2000);
  else window.addEventListener('load', function () { setTimeout(loadVendors, 2000); });
})();
</script>
