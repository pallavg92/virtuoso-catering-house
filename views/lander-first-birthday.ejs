<style>
/* ============================================================
   VIRTUOSO CATERING HOUSE — FIRST BIRTHDAY LANDER
   Built on the Virtuoso Catering House design system:
   tokens/colors.css, tokens/spacing.css, tokens/typography.css,
   components/core/Button.jsx, components/core/Input.jsx.
   Self-hosted fonts. No external CSS/JS/CDN. No form JS.
   ============================================================ */
@font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:300 600;font-display:swap;src:url('/fonts/cormorant-300.woff2') format('woff2')}
@font-face{font-family:'Cormorant Garamond';font-style:italic;font-weight:400;font-display:swap;src:url('/fonts/cormorant-italic-400.woff2') format('woff2')}
@font-face{font-family:'Work Sans';font-style:normal;font-weight:300 600;font-display:swap;src:url('/fonts/worksans-300-400-500-600.woff2') format('woff2')}

:root{
  /* base palette — verbatim from the design system's tokens/colors.css */
  --green-900:oklch(22% 0.035 145);
  --green-800:oklch(28% 0.045 145);
  --green-700:oklch(34% 0.05 145);
  --green-600:oklch(42% 0.055 145);
  --sage-500:oklch(58% 0.045 140);
  --sage-300:oklch(78% 0.03 135);
  --sage-200:oklch(87% 0.02 130);
  --amber-700:oklch(52% 0.11 65);
  --amber-600:oklch(60% 0.12 65);
  --amber-500:oklch(68% 0.12 68);
  --amber-300:oklch(84% 0.07 75);
  --clay-600:oklch(50% 0.08 45);
  --clay-400:oklch(68% 0.06 48);
  --parchment-100:oklch(97.5% 0.012 85);
  --parchment-200:oklch(95% 0.015 82);
  --parchment-300:oklch(91% 0.018 80);
  --linen-50:oklch(99% 0.006 85);
  --ink-900:oklch(18% 0.015 60);
  --ink-700:oklch(30% 0.015 60);
  --ink-500:oklch(46% 0.015 60);
  --ink-300:oklch(66% 0.012 60);

  /* semantic aliases */
  --surface-page:var(--parchment-100);
  --surface-card:var(--linen-50);
  --surface-card-alt:var(--parchment-200);
  --surface-inverse:var(--green-900);
  --surface-accent-wash:var(--sage-200);
  --text-primary:var(--ink-900);
  --text-secondary:var(--ink-500);
  --text-muted:var(--ink-300);
  --text-on-inverse:var(--parchment-100);
  --text-on-inverse-muted:var(--sage-300);
  --brand-primary:var(--green-800);
  --brand-primary-strong:var(--green-900);
  --brand-secondary:var(--sage-500);
  --brand-accent:var(--amber-600);
  --brand-accent-strong:var(--amber-700);
  --brand-clay:var(--clay-600);
  --border-hairline:oklch(85% 0.02 80 / 40%);
  --border-subtle:oklch(75% 0.02 80 / 55%);
  --border-on-inverse:oklch(97% 0.01 85 / 18%);
  --shadow-color:oklch(30% 0.03 100 / 12%);

  /* type */
  --font-display:'Cormorant Garamond',ui-serif,Georgia,serif;
  --font-body:'Work Sans',ui-sans-serif,system-ui,sans-serif;
  --text-display-xl:clamp(3rem,2.2rem + 3vw,5.5rem);
  --text-display-l:clamp(2.25rem,1.9rem + 1.6vw,3.5rem);
  --text-display-m:clamp(1.75rem,1.55rem + 0.9vw,2.5rem);
  --text-title:1.375rem;
  --text-body-l:1.125rem;
  --text-body:1rem;
  --text-body-s:0.875rem;
  --text-label:0.8125rem;
  --text-caption:0.75rem;
  --leading-tight:1.08;--leading-snug:1.25;--leading-normal:1.5;--leading-relaxed:1.7;
  --tracking-tight:-0.01em;--tracking-normal:0em;--tracking-label:0.22em;--tracking-wide:0.08em;
  --weight-light:300;--weight-regular:400;--weight-medium:500;--weight-semibold:600;

  /* space, radii, shadow, motion */
  --space-1:4px;--space-2:8px;--space-3:12px;--space-4:16px;--space-5:24px;
  --space-6:32px;--space-7:48px;--space-8:64px;--space-9:96px;--space-10:128px;
  --radius-sm:2px;--radius-md:4px;--radius-lg:8px;--radius-pill:999px;
  --shadow-card:0 1px 2px var(--shadow-color),0 8px 24px -12px var(--shadow-color);
  --shadow-raised:0 2px 4px var(--shadow-color),0 16px 40px -16px var(--shadow-color);
  --ease-standard:cubic-bezier(.4,0,.2,1);
  --duration-fast:150ms;--duration-normal:280ms;
  --container-max:1160px;
  --rule-hairline:1px solid var(--border-hairline);

  --pad:clamp(24px,5vw,48px);
}

*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--surface-page);color:var(--text-primary);font-family:var(--font-body);font-weight:var(--weight-light);-webkit-font-smoothing:antialiased;overflow-x:hidden}
img,video{display:block;max-width:100%;height:auto}
a{color:var(--text-primary);text-decoration:none;transition:background var(--duration-fast) var(--ease-standard),color var(--duration-fast) var(--ease-standard),border-color var(--duration-fast) var(--ease-standard)}
a:hover,a:active{color:var(--brand-accent-strong)}
:focus-visible{outline:2px solid var(--brand-secondary);outline-offset:2px}
::selection{background:var(--surface-accent-wash)}

.wrap{max-width:var(--container-max);margin:0 auto;width:100%;padding-left:var(--pad);padding-right:var(--pad)}
.band{padding-top:clamp(48px,7vw,96px);padding-bottom:clamp(48px,7vw,96px)}
.band--card{background:var(--surface-card);border-top:var(--rule-hairline)}
.band--inverse{background:var(--surface-inverse);color:var(--text-on-inverse)}
.stack{display:flex;flex-direction:column}
.rule{height:1px;width:48px;background:var(--brand-accent)}

/* — type voices — */
.eyebrow{font-size:var(--text-label);line-height:var(--leading-snug);font-weight:var(--weight-medium);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--brand-accent-strong);margin:0}
.h1{font-family:var(--font-display);font-weight:var(--weight-light);font-size:var(--text-display-l);line-height:var(--leading-tight);letter-spacing:var(--tracking-tight);margin:0;text-wrap:pretty}
.h1 em{font-style:italic;font-weight:var(--weight-regular);font-size:var(--text-display-m);line-height:var(--leading-snug);color:var(--brand-accent-strong);display:inline-block;margin-top:var(--space-2)}
.h2{font-family:var(--font-display);font-weight:var(--weight-light);font-size:var(--text-display-m);line-height:var(--leading-tight);letter-spacing:var(--tracking-tight);margin:0;text-wrap:pretty}
.h3{font-family:var(--font-display);font-weight:var(--weight-regular);font-size:var(--text-title);line-height:var(--leading-snug);margin:0}
.lede{font-size:var(--text-body-l);line-height:var(--leading-normal);color:var(--ink-700);margin:0;max-width:52ch;text-wrap:pretty}
.p{font-size:var(--text-body);line-height:var(--leading-relaxed);color:var(--text-secondary);margin:0;max-width:60ch;text-wrap:pretty}
.p--s{font-size:var(--text-body-s)}
.label{font-size:var(--text-label);line-height:var(--leading-snug);font-weight:var(--weight-medium);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--brand-primary);margin:0}
.label--sage{color:var(--text-secondary);font-size:var(--text-caption)}
.micro{font-size:var(--text-caption);line-height:var(--leading-relaxed);font-weight:var(--weight-regular);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-secondary);margin:0}
.fine{font-size:var(--text-body-s);line-height:var(--leading-relaxed);color:var(--text-secondary);margin:0}
.fine--muted{color:var(--text-secondary);font-size:var(--text-caption)}

/* HIGHLIGHT — the offer phrase, amber-300 wash (design-system accent tint) */
mark.hl{background:var(--amber-300);color:var(--ink-900);font-weight:var(--weight-medium);padding:2px 6px;border-radius:var(--radius-sm);-webkit-box-decoration-break:clone;box-decoration-break:clone}

/* — buttons: design system components/core/Button.jsx — */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--space-2);font-family:var(--font-body);font-weight:var(--weight-medium);font-size:var(--text-label);letter-spacing:var(--tracking-wide);text-transform:uppercase;padding:14px 28px;min-height:48px;border-radius:var(--radius-pill);border:1px solid transparent;cursor:pointer;transition:background var(--duration-fast) var(--ease-standard),color var(--duration-fast) var(--ease-standard),border-color var(--duration-fast) var(--ease-standard)}
.btn--primary{background:var(--brand-primary);color:var(--text-on-inverse)}
.btn--primary:hover{background:var(--brand-primary-strong);color:var(--text-on-inverse)}
.btn--accent{background:var(--brand-accent);color:var(--ink-900)}
.btn--accent:hover{background:var(--brand-accent-strong);color:var(--text-on-inverse)}
.btn--secondary{background:transparent;color:var(--brand-primary);border-color:var(--brand-primary)}
.btn--secondary:hover{background:var(--surface-accent-wash)}
/* PRIMARY PAGE ACTION — deliberately the loudest element on the page */
.btn--hero{font-size:0.9375rem;font-weight:var(--weight-semibold);padding:18px 36px;min-height:56px;box-shadow:var(--shadow-raised)}
.btn__arrow{font-size:var(--text-body-l);line-height:1}
@keyframes ctaPulse{
  0%,100%{box-shadow:var(--shadow-raised),0 0 0 0 oklch(60% 0.12 65 / 45%)}
  50%{box-shadow:var(--shadow-raised),0 0 0 10px oklch(60% 0.12 65 / 0%)}
}
.btn--pulse{animation:ctaPulse 2600ms var(--ease-standard) infinite}
.btn--pulse:hover{animation:none}

/* — top bar — */
.topbar{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);padding-top:var(--space-4);padding-bottom:var(--space-4);border-bottom:var(--rule-hairline)}
.wordmark{font-family:var(--font-display);font-weight:var(--weight-light);font-size:var(--text-title);line-height:var(--leading-tight);letter-spacing:var(--tracking-wide);text-transform:uppercase;display:block}
.wordmark__sub{font-size:var(--text-caption);line-height:var(--leading-snug);font-weight:var(--weight-regular);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-secondary);display:block;margin-top:var(--space-1)}
.tel{display:inline-flex;align-items:center;min-height:44px;font-size:var(--text-label);font-weight:var(--weight-medium);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--brand-primary)}

/* — hero: overlay (default) — headline sits ON the photograph — */
.hero-overlay{position:relative;isolation:isolate;background-color:var(--green-900);background-image:url('/img/hero-first-birthday.jpg');background-size:cover;background-position:52% 46%;border-bottom:var(--rule-hairline)}
/* scrim: guarantees AA contrast for parchment text over the photograph */
.hero-overlay::before{content:"";position:absolute;inset:0;z-index:0;background:linear-gradient(100deg,oklch(16% 0.03 145 / 94%) 0%,oklch(16% 0.03 145 / 86%) 38%,oklch(16% 0.03 145 / 58%) 68%,oklch(16% 0.03 145 / 34%) 100%)}
.hero-overlay__inner{position:relative;z-index:1;display:flex;flex-direction:column;gap:var(--space-4);padding-top:clamp(48px,8vw,120px);padding-bottom:clamp(48px,8vw,120px)}
.hero-overlay .eyebrow,.hero-overlay .h1 em{color:var(--amber-300)}
.hero-overlay .rule{background:var(--amber-300)}
.hero-overlay .h1{color:var(--text-on-inverse);max-width:22ch}
.hero-overlay .lede{color:var(--parchment-300);max-width:48ch}
.hero-overlay .p--s,.hero-overlay .micro{color:var(--text-on-inverse-muted)}
.hero-overlay .btn--accent{box-shadow:0 2px 4px oklch(16% 0.03 145 / 35%),0 16px 40px -16px oklch(16% 0.03 145 / 45%)}
.hero-overlay .btn--accent:hover{background:var(--amber-300);color:var(--ink-900)}

/* — hero: split alternative — photograph beside the copy — */
.hero{display:flex;flex-direction:column;gap:clamp(24px,4vw,48px);align-items:center;padding-top:clamp(24px,5vw,64px);padding-bottom:clamp(32px,5vw,64px)}
.hero__copy{display:flex;flex-direction:column;gap:var(--space-4)}
.figure{margin:0;display:flex;flex-direction:column;gap:var(--space-3)}
.ph{background:var(--parchment-300);border:var(--rule-hairline);border-radius:var(--radius-md);display:flex;align-items:center;justify-content:center;text-align:center;overflow:hidden}
.ph span{font-size:var(--text-caption);line-height:var(--leading-relaxed);font-weight:var(--weight-regular);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-secondary)}
.ph--hero{aspect-ratio:4/5}
.ph--45{aspect-ratio:4/5}
.ph--11{aspect-ratio:1/1}
.ph img,.ph video{width:100%;height:100%;object-fit:cover;border-radius:var(--radius-md)}

/* — proof strip — */
.thumbs{display:grid;grid-template-columns:1fr;gap:clamp(12px,2vw,24px)}
.thumbs figcaption{font-size:var(--text-label);line-height:var(--leading-snug);font-weight:var(--weight-medium);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--ink-700);margin:0}

/* — form: design system components/core/Input.jsx — */
.enquiry{display:flex;flex-direction:column;gap:clamp(24px,4vw,64px);padding-top:clamp(32px,6vw,96px);padding-bottom:clamp(32px,6vw,96px)}
.form{background:var(--surface-card-alt);border:var(--rule-hairline);border-radius:var(--radius-md);box-shadow:var(--shadow-card);padding:clamp(24px,4vw,32px);display:flex;flex-direction:column;gap:var(--space-5)}
.field{display:flex;flex-direction:column;gap:6px}
.field label{font-size:var(--text-label);line-height:var(--leading-snug);font-weight:var(--weight-medium);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-secondary)}
.field label .opt{letter-spacing:0;text-transform:none;font-weight:var(--weight-light);color:var(--text-secondary)}
.field input,.field select,.field textarea{width:100%;min-height:48px;padding:12px 14px;font-family:var(--font-body);font-size:var(--text-body);line-height:var(--leading-normal);font-weight:var(--weight-light);color:var(--text-primary);background:var(--surface-card);border:var(--rule-hairline);border-radius:var(--radius-md);appearance:none;transition:border-color var(--duration-fast) var(--ease-standard)}
.field textarea{min-height:112px;line-height:var(--leading-relaxed);resize:vertical}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--brand-secondary);outline:2px solid var(--brand-secondary);outline-offset:2px}
.lander-field__error{font-size:var(--text-body-s);line-height:var(--leading-normal);color:var(--brand-clay)}
.lander-field__error:not(:empty)::before{content:"! ";font-weight:var(--weight-semibold)}
.field:has(.lander-field__error:not(:empty)) input,
.field:has(.lander-field__error:not(:empty)) select,
.field:has(.lander-field__error:not(:empty)) textarea{border-color:var(--brand-clay);border-width:2px}
.form__foot{display:flex;flex-direction:column;gap:var(--space-4);padding-top:var(--space-4);border-top:var(--rule-hairline)}
.form__foot .btn{align-self:flex-start}
#lander-status{font-size:var(--text-body);line-height:var(--leading-normal);color:var(--ink-700);margin:0}
#lander-status:empty{display:none}

/* — process — */
.steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr;gap:clamp(24px,3vw,32px)}
.steps li{display:flex;flex-direction:column;gap:var(--space-3);background:var(--surface-card);border:var(--rule-hairline);border-radius:var(--radius-md);box-shadow:var(--shadow-card);padding:var(--space-5)}
.note{background:var(--surface-accent-wash);border-radius:var(--radius-md);padding:20px 24px;max-width:64ch}
.note p{font-size:var(--text-body);line-height:var(--leading-relaxed);color:var(--ink-700);margin:0}

/* — case study — */
.case{display:flex;flex-direction:column;gap:clamp(32px,4vw,48px)}
.spec{margin:0;display:flex;flex-direction:column;border-top:var(--rule-hairline)}
.spec>div{display:flex;flex-direction:column;gap:var(--space-1);padding:var(--space-4) 0;border-bottom:var(--rule-hairline)}
.spec dt{font-size:var(--text-caption);line-height:var(--leading-snug);font-weight:var(--weight-medium);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-secondary)}
.spec dd{font-size:var(--text-body);line-height:var(--leading-normal);color:var(--ink-700);margin:0}
.spec dd.num{font-variant-numeric:tabular-nums}
.gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(12px,2vw,16px);align-content:start}
.quote{margin:0;background:var(--surface-card-alt);border-radius:var(--radius-md);padding:var(--space-5) 28px;max-width:52ch}
.quote p{font-family:var(--font-display);font-weight:var(--weight-regular);font-style:italic;font-size:var(--text-title);line-height:var(--leading-snug);color:var(--text-primary);margin:0 0 var(--space-3)}
.quote footer{font-size:var(--text-caption);line-height:var(--leading-snug);font-weight:var(--weight-medium);letter-spacing:var(--tracking-label);text-transform:uppercase;color:var(--text-secondary)}

/* — inclusions — */
.incl{display:grid;grid-template-columns:1fr;gap:clamp(16px,2vw,24px)}
.incl>div{display:flex;flex-direction:column;gap:var(--space-2);background:var(--surface-card);border:var(--rule-hairline);border-radius:var(--radius-md);padding:20px 24px}

/* — execution pills — */
.proofs{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:var(--space-2)}
.proofs li{font-size:var(--text-label);line-height:var(--leading-snug);font-weight:var(--weight-medium);letter-spacing:var(--tracking-wide);text-transform:uppercase;color:var(--brand-primary);background:var(--surface-card-alt);border:var(--rule-hairline);border-radius:var(--radius-pill);padding:12px 20px}

/* — inverse band + footer — */
.band--inverse .h2{color:var(--text-on-inverse)}
.band--inverse .lede,.band--inverse .fine{color:var(--text-on-inverse-muted)}
.band--inverse .btn--accent:hover{background:var(--amber-300);color:var(--ink-900)}
.foot{border-top:var(--rule-hairline);display:flex;flex-wrap:wrap;gap:8px 32px;align-items:center;padding-top:var(--space-5);padding-bottom:var(--space-7)}
.foot a{display:inline-flex;align-items:center;min-height:44px;color:var(--brand-primary)}

/* — tablet / desktop — */
@media (min-width:760px){
  .hero{flex-direction:row}
  .hero__copy{flex:1 1 55%}
  .hero .figure{flex:1 1 45%}
  .thumbs{grid-template-columns:repeat(3,1fr)}
  .steps{grid-template-columns:repeat(2,1fr)}
  .incl{grid-template-columns:repeat(2,1fr)}
  .enquiry{flex-direction:row;align-items:flex-start}
  .enquiry__intro{flex:1 1 40%}
  .form{flex:1 1 60%}
  .case__body{display:flex;gap:clamp(24px,4vw,48px)}
  .case__body .spec{flex:1 1 45%}
  .case__body .gallery{flex:1 1 55%}
  .split{display:flex;gap:clamp(24px,4vw,48px);align-items:flex-start}
  .split>*{flex:1 1 50%}
}
@media (min-width:1040px){
  .steps{grid-template-columns:repeat(4,1fr)}
  .incl{grid-template-columns:repeat(4,1fr)}
}

@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *{transition-duration:.001ms !important;animation:none !important}
}
</style>
</head>

<body>

<!-- 1 — TOP BAR ------------------------------------------------------- -->
<header class="wrap topbar">
  <!-- Wordmark is deliberately not a link. On a page bought click by click,
       a logo linking to the homepage is a paid visitor walking away. -->
  <div aria-label="Virtuoso Catering House">
    <span class="wordmark">Virtu&#332;so</span>
    <span class="wordmark__sub">Catering House</span>
  </div>
  <a class="tel" href="tel:+918700915463">+91 87009 15463</a>
</header>

<main>
<!-- 2 — HERO (overlay: headline over the photograph) --------------------
     To use the SPLIT hero instead (photo beside the copy), delete this
     <section class="hero-overlay"> block and un-comment the one below it. -->
<section class="hero-overlay">
  <div class="wrap hero-overlay__inner">
    <div class="stack" style="gap:var(--space-2);max-width:34ch">
      <p class="eyebrow">First birthdays &middot; Delhi NCR</p>
      <div class="rule"></div>
    </div>
    <h1 class="h1">A first birthday should feel like your child&rsquo;s story.<br /><em>Not a menu you&rsquo;ve seen before.</em></h1>
    <p class="lede">For celebrations of 50 guests or more, Virtuoso brings the menu, live experiences, presentation and service together as <mark class="hl">one personalised F&amp;B experience</mark>.</p>
    <p class="p p--s" style="max-width:52ch">Begin with a short conversation with our F&amp;B curator. Once the brief and commercial scope are aligned, we create your first personalised direction within 24 hours.</p>
    <div style="display:flex;flex-wrap:wrap;gap:var(--space-4);align-items:center;margin-top:var(--space-2)">
      <a class="btn btn--accent btn--hero btn--pulse" href="#lander-form">Plan my child&rsquo;s first birthday <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
    </div>
    <p class="micro">Real event concepts &middot; Professional execution &middot; Tasting-led finalisation</p>
  </div>
</section>

<!-- ALTERNATIVE HERO — photograph beside the copy. Un-comment to use.
<section class="wrap hero">
  <div class="hero__copy">
    <div class="stack" style="gap:var(––space-2)">
      <p class="eyebrow">First birthdays &middot; Delhi NCR</p>
      <div class="rule"></div>
    </div>
    <h1 class="h1">A first birthday should feel like your child&rsquo;s story.<br /><em>Not a menu you&rsquo;ve seen before.</em></h1>
    <p class="lede">For celebrations of 50 guests or more, Virtuoso brings the menu, live experiences, presentation and service together as <mark class="hl">one personalised F&amp;B experience</mark>.</p>
    <p class="p p––s">Begin with a short conversation with our F&amp;B curator. Once the brief and commercial scope are aligned, we create your first personalised direction within 24 hours.</p>
    <!–– PRIMARY PAGE ACTION. Amber accent + raised shadow + soft pulse so it reads
         unmistakably as the thing to click. Remove .btn––pulse for a static CTA. ––>
    <div style="display:flex;flex-wrap:wrap;gap:var(––space-4);align-items:center;margin-top:var(––space-2)">
      <a class="btn btn––accent btn––hero btn––pulse" href="#lander-form">Plan my child&rsquo;s first birthday <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
    </div>
    <p class="micro">Real event concepts &middot; Professional execution &middot; Tasting-led finalisation</p>
  </div>

  <figure class="figure">
    <div class="ph ph––hero"><img src="/img/hero-first-birthday.jpg" alt="Long brass buffet counter styled with table lamps, fresh flowers and stacked service ware at a Virtuoso event" width="874" height="1100" /></div>
    <figcaption class="fine">A first-birthday experience planned and executed by Virtuoso Catering House.</figcaption>
  </figure>
</section>
-->

<!-- 3 — ENQUIRY FORM -------------------------------------------------- -->
<section class="wrap enquiry" id="enquiry">
  <div class="enquiry__intro stack" style="gap:var(--space-4)">
    <div class="stack" style="gap:var(--space-2)">
      <p class="eyebrow">Start the conversation</p>
      <div class="rule"></div>
    </div>
    <h2 class="h2">Tell us about the first birthday.</h2>
    <p class="p" style="max-width:46ch">Share the essentials below. A Virtuoso F&amp;B curator will call to understand your celebration, show relevant work and explain how we would approach it.</p>
  </div>

  <!-- POST route: replace with the existing Express route, e.g. action="/enquiry" -->
  <form class="form" id="lander-form" method="post" action="/lp/first-birthday">
    <!-- This app has no CSRF middleware. If one is added later, render a
         hidden _csrf input here (EJS evaluates its tags even inside HTML
         comments, so the example cannot be left commented out). -->

    <div class="field">
      <label for="f-name">Name</label>
      <input id="f-name" name="name" type="text" required autocomplete="name" value="<%= typeof values !== 'undefined' && values.name ? values.name : '' %>" />
      <span class="lander-field__error" data-error-for="name"><%= typeof errors !== 'undefined' && errors.name ? errors.name : '' %></span>
    </div>

    <div class="field">
      <label for="f-phone">Mobile / WhatsApp</label>
      <input id="f-phone" name="phone" type="tel" required inputmode="tel" autocomplete="tel" value="<%= typeof values !== 'undefined' && values.phone ? values.phone : '' %>" />
      <span class="lander-field__error" data-error-for="phone"><%= typeof errors !== 'undefined' && errors.phone ? errors.phone : '' %></span>
    </div>

    <div class="field">
      <label for="f-email">Email</label>
      <input id="f-email" name="email" type="email" required inputmode="email" autocomplete="email" value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>" />
      <span class="lander-field__error" data-error-for="email"><%= typeof errors !== 'undefined' && errors.email ? errors.email : '' %></span>
    </div>

    <div class="field">
      <label for="f-date">Date of the celebration <span class="opt">(optional)</span></label>
      <input id="f-date" name="eventDate" type="date" value="<%= typeof values !== 'undefined' && values.eventDate ? values.eventDate : '' %>" />
      <span class="lander-field__error" data-error-for="eventDate"><%= typeof errors !== 'undefined' && errors.eventDate ? errors.eventDate : '' %></span>
    </div>

    <div class="field">
      <label for="f-guests">Approximate guest count</label>
      <select id="f-guests" name="guestCount" required>
        <option value=""<%= (typeof values !== 'undefined' && values.guestCount === "") ? ' selected' : '' %>>Select</option>
        <option value="Under 50"<%= (typeof values !== 'undefined' && values.guestCount === "Under 50") ? ' selected' : '' %>>Under 50</option>
        <option value="50&ndash;75"<%= (typeof values !== 'undefined' && values.guestCount === "50&ndash;75") ? ' selected' : '' %>>50&ndash;75</option>
        <option value="76&ndash;100"<%= (typeof values !== 'undefined' && values.guestCount === "76&ndash;100") ? ' selected' : '' %>>76&ndash;100</option>
        <option value="101&ndash;150"<%= (typeof values !== 'undefined' && values.guestCount === "101&ndash;150") ? ' selected' : '' %>>101&ndash;150</option>
        <option value="151&ndash;200"<%= (typeof values !== 'undefined' && values.guestCount === "151&ndash;200") ? ' selected' : '' %>>151&ndash;200</option>
        <option value="201&ndash;250"<%= (typeof values !== 'undefined' && values.guestCount === "201&ndash;250") ? ' selected' : '' %>>201&ndash;250</option>
        <option value="More than 250"<%= (typeof values !== 'undefined' && values.guestCount === "More than 250") ? ' selected' : '' %>>More than 250</option>
        <option value="Not finalised yet"<%= (typeof values !== 'undefined' && values.guestCount === "Not finalised yet") ? ' selected' : '' %>>Not finalised yet</option>
      </select>
      <span class="lander-field__error" data-error-for="guestCount"><%= typeof errors !== 'undefined' && errors.guestCount ? errors.guestCount : '' %></span>
    </div>

    <div class="field">
      <label for="f-locality">Event locality</label>
      <input id="f-locality" name="eventLocation" type="text" required value="<%= typeof values !== 'undefined' && values.eventLocation ? values.eventLocation : '' %>" />
      <span class="lander-field__error" data-error-for="eventLocation"><%= typeof errors !== 'undefined' && errors.eventLocation ? errors.eventLocation : '' %></span>
    </div>

    <div class="field">
      <label for="f-vision">What are you imagining? <span class="opt">(optional)</span></label>
      <textarea id="f-vision" name="eventVision" rows="4" placeholder="Tell us about the food, atmosphere, theme or guest experience you have in mind."><%= typeof values !== 'undefined' && values.eventVision ? values.eventVision : '' %></textarea>
      <span class="lander-field__error" data-error-for="eventVision"><%= typeof errors !== 'undefined' && errors.eventVision ? errors.eventVision : '' %></span>
    </div>

    <input type="hidden" name="eventType" value="First Birthday" />

    <div class="form__foot">
      <button class="btn btn--accent btn--hero" id="lander-submit" type="submit">Request my curator call <span class="btn__arrow" aria-hidden="true">&rarr;</span></button>
      <p id="lander-status" role="status" aria-live="polite"><%= typeof status !== 'undefined' ? status : '' %></p>
      <p class="fine">We primarily design complete first-birthday food experiences for celebrations of 50 guests or more across Delhi NCR.</p>
      <p class="fine fine--muted">By submitting, you agree that Virtuoso Catering House may contact you about your celebration. Your information will not be shared with third parties.</p>
    </div>
  </form>
</section>

<!-- 4 — COMPACT PROOF ------------------------------------------------- -->
<section class="band--card" style="border-bottom:var(--rule-hairline)">
  <div class="wrap stack" style="gap:var(--space-5);padding-top:clamp(32px,5vw,64px);padding-bottom:clamp(32px,5vw,64px)">
    <div class="stack" style="gap:var(--space-3)">
      <p class="eyebrow">Real first-birthday work</p>
      <p class="lede">See how Virtuoso brings the menu, presentation, live experiences and service together as one coordinated celebration.</p>
    </div>
    <div class="thumbs">
      <figure class="figure" style="gap:var(--space-2)">
        <div class="ph ph--45"><img src="/img/proof-setting.jpg" alt="Tasting display of signature dishes on wooden risers with named Virtuoso menu cards, candles and gypsophila" width="665" height="941" /></div>
        <figcaption>Overall setting</figcaption>
      </figure>
      <figure class="figure" style="gap:var(--space-2)">
        <div class="ph ph--45"><img src="/img/proof-live.jpg" alt="Chef finishing a dish on a live teppan counter, steam rising as the sauce hits the plate" width="613" height="746" /></div>
        <figcaption>Live food experience</figcaption>
      </figure>
      <figure class="figure" style="gap:var(--space-2)">
        <div class="ph ph--45"><img src="/img/proof-service.jpg" alt="Polished brass serving bowls of pasta and vegetables arranged on a stepped counter with gypsophila" width="613" height="747" /></div>
        <figcaption>Service detail</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- 5 — HOW THE PROCESS WORKS ----------------------------------------- -->
<section class="wrap band">
  <div class="stack" style="gap:clamp(32px,4vw,48px)">
    <div class="stack" style="gap:var(--space-4)">
      <div class="stack" style="gap:var(--space-2)">
        <p class="eyebrow">From brief to celebration</p>
        <div class="rule"></div>
      </div>
      <h2 class="h2" style="max-width:20ch">A considered process, before anything reaches the table.</h2>
    </div>

    <ol class="steps">
      <li>
        <span class="label label--sage">Step 01</span>
        <h3 class="h3">Tell us what you are planning</h3>
        <p class="p">Share the date, approximate guest count, locality and the kind of celebration you have in mind.</p>
      </li>
      <li>
        <span class="label label--sage">Step 02</span>
        <h3 class="h3">Speak with an F&amp;B curator</h3>
        <p class="p">We understand the family, food preferences, venue, service expectations and the experience you want your guests to have.</p>
      </li>
      <li>
        <span class="label label--sage">Step 03</span>
        <h3 class="h3">Receive a personalised direction</h3>
        <p class="p">Once the brief and commercial scope are aligned, we develop the initial F&amp;B concept within 24 hours.</p>
      </li>
      <li>
        <span class="label label--sage">Step 04</span>
        <h3 class="h3">Taste, refine and confirm</h3>
        <p class="p">Selected dishes are tasted, details are refined and the final experience is prepared for execution.</p>
      </li>
    </ol>

    <div class="note">
      <p>The 24-hour period begins after the brief and commercial scope are aligned in step 03 &mdash; not at form submission.</p>
    </div>
  </div>
</section>

<!-- 6 — REAL FIRST-BIRTHDAY CASE STUDY -------------------------------- -->
<section class="band band--card">
  <div class="wrap case">
    <div class="stack" style="gap:var(--space-4)">
      <div class="stack" style="gap:var(--space-2)">
        <p class="eyebrow">Proof of work</p>
        <div class="rule"></div>
      </div>
      <h2 class="h2" style="max-width:20ch">From a family&rsquo;s idea to a complete F&amp;B experience.</h2>
    </div>

    <div class="case__body">
      <dl class="spec">
        <div><dt>Event</dt><dd>Shauryas First Birthday</dd></div>
        <div><dt>Location</dt><dd>Noida</dd></div>
        <div><dt>Guest count</dt><dd class="num">200</dd></div>
        <div><dt>Family brief</dt><dd>Give us a perfect evening of snacks &amp; Live,, no buffet. We also want an elaborate grazing table where guests can be mingle with the drinks</dd></div>
      </dl>

      <div class="gallery">
        <div class="ph ph--45"><img src="/img/case-setting.jpg" alt="Wider view of the celebration setting with themed food counters" width="600" height="751" /></div>
        <div class="ph ph--45"><img src="/img/case-presentation.jpg" alt="Elephant-themed cupcake made for a first birthday" width="405" height="746" /></div>
        <div class="ph ph--45"><img src="/img/case-counter.jpg" alt="Live pizza counter with printed menu signage" width="613" height="747" /></div>
        <div class="ph ph--45"><img src="/img/case-dessert.jpg" alt="Pastel dessert display with individual servings" width="613" height="765" /></div>
      </div>
    </div>

    <blockquote class="quote">
      <p>&ldquo;A big thanks to team virtuoso for creating the perfect food experience for Shauryas first birthday. No one could have done it better&rdquo;</p>
      <footer>Parnika &amp; Akash</footer>
    </blockquote>
  </div>
</section>

<!-- 7 — WHAT THE PERSONALISED CONCEPT CAN INCLUDE ---------------------- -->
<section class="wrap band">
  <div class="stack" style="gap:clamp(32px,4vw,48px)">
    <div class="stack" style="gap:var(--space-4)">
      <div class="stack" style="gap:var(--space-2)">
        <p class="eyebrow">One cohesive direction</p>
        <div class="rule"></div>
      </div>
      <h2 class="h2" style="max-width:18ch">Not separate dishes. One complete experience.</h2>
    </div>
    <div class="incl">
      <div><h3 class="label">Event narrative</h3><p class="p">A central idea that connects the child, family and occasion.</p></div>
      <div><h3 class="label">Menu architecture</h3><p class="p">A considered progression of canap&eacute;s, live experiences, mains and desserts.</p></div>
      <div><h3 class="label">Live experiences</h3><p class="p">Food moments designed to encourage interaction and become part of the celebration.</p></div>
      <div><h3 class="label">Presentation direction</h3><p class="p">A visual language for the food, displays, counters and service elements.</p></div>
      <div><h3 class="label">Counter styling</h3><p class="p">Materials, forms and presentation details that support the event concept.</p></div>
      <div><h3 class="label">Service style</h3><p class="p">A service approach designed around the venue, guest flow and atmosphere.</p></div>
      <div><h3 class="label">Dessert experience</h3><p class="p">A finale that feels part of the story rather than an afterthought.</p></div>
      <div><h3 class="label">Bar</h3><p class="p">Available as an additional curated service where required.</p></div>
    </div>
  </div>
</section>

<!-- 8 — PROFESSIONAL EXECUTION ---------------------------------------- -->
<section class="band band--card" style="border-bottom:var(--rule-hairline)">
  <div class="wrap split">
    <div class="stack" style="gap:var(--space-5)">
      <div class="stack" style="gap:var(--space-4)">
        <div class="stack" style="gap:var(--space-2)">
          <p class="eyebrow">The idea is only the beginning</p>
          <div class="rule"></div>
        </div>
        <h2 class="h2">Designed thoughtfully. Executed professionally.</h2>
      </div>
      <p class="lede">A beautiful concept only matters when the service, kitchen, presentation and guest experience work together on the day. Virtuoso plans the food and its execution as one coordinated responsibility.</p>
      <!-- Keep these three only while they remain operationally true. -->
      <ul class="proofs">
        <li>Chef-led preparation</li>
        <li>Planned service execution</li>
        <li>Tasting-led finalisation</li>
      </ul>
    </div>
    <div class="gallery">
      <div class="ph ph--11"><img src="/img/exec-chefs.jpg" alt="Chef presenting a freshly plated pasta dish" width="597" height="728" /></div>
      <div class="ph ph--11"><img src="/img/exec-staff.jpg" alt="Uniformed service team lined up before guests arrive" width="675" height="900" /></div>
      <div class="ph ph--11"><img src="/img/exec-counter.jpg" alt="Live pasta counter being served during an event" width="549" height="669" /></div>
      <div class="ph ph--11"><img src="/img/exec-guests.jpg" alt="Individually portioned canap&eacute;s ready to be served" width="900" height="536" /></div>
    </div>
  </div>
</section>

<!-- 9 — TASTING -------------------------------------------------------- -->
<section class="wrap band split">
  <div class="stack" style="gap:var(--space-4)">
    <div class="stack" style="gap:var(--space-2)">
      <p class="eyebrow">Before your guests taste it</p>
      <div class="rule"></div>
    </div>
    <h2 class="h2">You experience the direction first.</h2>
  </div>
  <p class="lede">Once the concept and commercial framework are agreed, the tasting allows the family to experience selected dishes, discuss refinements and build confidence in the final menu.</p>
</section>

<!-- 10 — BROADER CREDIBILITY ------------------------------------------- -->
<section class="wrap stack" style="gap:var(--space-5);padding-bottom:clamp(48px,7vw,96px)">
  <h2 class="h2" style="max-width:26ch">Experience built across intimate celebrations and high-stakes hospitality.</h2>
</section>

<!-- 11 — CLOSING CTA BAND ---------------------------------------------- -->
<section class="band--inverse">
  <div class="wrap stack" style="gap:var(--space-5);align-items:flex-start;padding-top:clamp(56px,8vw,128px);padding-bottom:clamp(56px,8vw,128px)">
    <h2 class="h2" style="max-width:20ch;font-size:var(--text-display-l)">Begin with the story you want the celebration to tell.</h2>
    <p class="lede">Share the essentials with our curator. If the occasion fits Virtuoso&rsquo;s scope, we will understand the brief, align the commercial framework and create your first personalised F&amp;B direction within 24 hours.</p>
    <a class="btn btn--accent btn--hero" href="#lander-form" style="margin-top:var(--space-2)">Discuss my first birthday <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
    <!-- Keep this line only if it is operationally true; otherwise delete it. -->
    <p class="fine">We accept a limited number of private celebrations on each date.</p>
  </div>
</section>
</main>

<!-- 12 — FOOTER --------------------------------------------------------- -->
<footer class="wrap foot">
  <span class="wordmark">Virtu&#332;so</span>
  <span class="fine">Sector 61, Noida</span>
  <a class="fine" href="tel:+918700915463">+91 87009 15463</a>
  <span class="fine">virtuosocatering@gmail.com</span>
  <a class="fine" href="/privacy-policy">Privacy policy</a>
</footer>

</body>
</html>
