<body>

<!-- 01 TOP BAR -->
<header class="wrap topbar">
  <!-- Not a link: on a paid-traffic page the logo is a side door. Phone stays tappable. -->
  <div>
    <span class="wordmark">Virtu&#332;so</span>
    <span class="wordmark__sub">Catering House</span>
  </div>
  <a class="tel" href="tel:+918700915463">+91 87009 15463</a>
</header>

<main>
<!-- 02 HERO -->
<section class="hero">
  <div class="wrap hero__inner">
    <p class="eyebrow">First birthdays &middot; Delhi NCR &middot; 50 guests or more</p>
    <h1 class="h1">A first birthday should feel like your child&rsquo;s story.<br /><em>Not a menu you&rsquo;ve seen before.</em></h1>
    <div class="stack" style="gap:12px;max-width:54ch">
      <p class="lede" style="font-size:clamp(16px,.95rem + .3vw,19px)">Virtuoso designs the food experience around the people, the occasion and the way you want the celebration to feel.</p>
      <p class="lede" style="font-size:clamp(16px,.95rem + .3vw,19px)">From passed canap&eacute;s and live counters to a plated buffet, presentation and dessert - everything is planned as one experience.</p>
      <p class="lede" style="color:var(--card)">So <mark class="hl">the food becomes the party</mark>, not simply the meal at it.</p>
    </div>
    <div class="stack" style="gap:14px;align-items:flex-start;margin-top:6px">
      <a class="btn" href="#lander-form">Plan my child&rsquo;s first birthday <span class="btn__arrow" aria-hidden="true">&rarr;</span></a>
      <p class="hero__proof"><strong>The team trusted for hospitality by Ferrari APAC, Lamborghini, Tesla India and BMW.</strong> <span>One conversation. One written plan within 24 hours.</span></p>
    </div>
  </div>
</section>

<!-- 03 NAMES -->
<section class="names">
  <div class="wrap names__row">
    <p><span class="k">Catering for</span>Ferrari APAC &middot; Lamborghini &middot; Tesla India &middot; BMW &middot; Bath &amp; Body Works</p>
    <p><span class="k">As seen in</span>Times of India &middot; Economic Times &middot; India Today &middot; News18 &middot; ANI</p>
    <p><span class="k">Founded by</span>Aarti Sharma and Pallav Goel &middot; FSSAI Licensed</p>
  </div>
</section>

<!-- 04 THE WORK -->
<section class="wrap stack" style="gap:28px;padding-top:clamp(40px,6vw,80px);padding-bottom:clamp(32px,5vw,64px)">
  <h2 class="h2" style="max-width:24ch">This is what a Virtuoso first birthday looks like.</h2>
  <div class="work">
    <figure>
      <div class="frame frame--32"><img loading="lazy" src="/img/proof-setting.jpg" alt="Grazing display and food styling at a first-birthday celebration" width="613" height="765" /></div>
      <figcaption><strong>The table.</strong> Grazing displays and food styling designed for guests to discover, share and linger around.</figcaption>
    </figure>
    <figure>
      <div class="frame frame--32"><img loading="lazy" src="/img/proof-live.jpg" alt="Live wood-fired pizza station plating for guests" width="613" height="765" /></div>
      <figcaption><strong>The live experience.</strong> Food finished in front of your guests - chosen as much for the moment it creates as for the dish itself.</figcaption>
    </figure>
    <figure>
      <div class="frame frame--32"><img loading="lazy" src="/img/proof-service.jpg" alt="Virtuoso-branded tray of individually plated canap&eacute;s" width="613" height="747" /></div>
      <figcaption><strong>The service.</strong> Canap&eacute;s are passed, live counters are attended and mains are plated for your guests - so dinner never becomes a buffet queue.</figcaption>
    </figure>
  </div>
</section>

<!-- 05 THRESHOLD + FORM -->
<section class="enquiry" id="enquiry">
  <div class="wrap enquiry__grid">
    <div class="stack" style="gap:22px">
      <h2 class="h2">Tell us about the celebration.</h2>
      <div class="threshold">
        <p class="eyebrow">Before you write to us</p>
        <p class="threshold__price">First-birthday experiences begin at <span>&#8377;3,500 per guest</span>.</p>
        <p class="p">Our work is designed for celebrations of 50 guests or more where the menu, presentation and service are planned together as one experience.</p>
      </div>
      <p class="p" style="max-width:44ch">Share the essentials. <strong>One person from Virtuoso will call you once</strong> to understand your family, the venue and how you want the evening to feel. No chasing. No repeated sales calls.</p>
    </div>

    <form class="form" id="lander-form" method="post" action="/lp/first-birthday">
      <%# If the app uses CSRF, render a hidden _csrf input here. %>
      <div class="row">
        <div class="field">
          <label for="f-name">Your name</label>
          <input id="f-name" name="name" type="text" required autocomplete="name" value="<%= typeof values !== 'undefined' && values.name ? values.name : '' %>" />
          <span class="lander-field__error" data-error-for="name"><%= typeof errors !== 'undefined' && errors.name ? errors.name : '' %></span>
        </div>
        <div class="field">
          <label for="f-phone">Mobile / WhatsApp</label>
          <input id="f-phone" name="phone" type="tel" required inputmode="tel" autocomplete="tel" value="<%= typeof values !== 'undefined' && values.phone ? values.phone : '' %>" />
          <span class="lander-field__error" data-error-for="phone"><%= typeof errors !== 'undefined' && errors.phone ? errors.phone : '' %></span>
        </div>
      </div>
      <div class="row">
        <div class="field">
          <label for="f-email">Email</label>
          <input id="f-email" name="email" type="email" required inputmode="email" autocomplete="email" value="<%= typeof values !== 'undefined' && values.email ? values.email : '' %>" />
          <span class="lander-field__error" data-error-for="email"><%= typeof errors !== 'undefined' && errors.email ? errors.email : '' %></span>
        </div>
        <div class="field">
          <label for="f-date">Date <span class="opt">(if known)</span></label>
          <input id="f-date" name="eventDate" type="date" value="<%= typeof values !== 'undefined' && values.eventDate ? values.eventDate : '' %>" />
          <span class="lander-field__error" data-error-for="eventDate"><%= typeof errors !== 'undefined' && errors.eventDate ? errors.eventDate : '' %></span>
        </div>
        <div class="field">
          <label for="f-guests">Guests</label>
          <select id="f-guests" name="guestCount" required>
            <option value=""<%= (typeof values !== 'undefined' && values.guestCount === "") ? ' selected' : '' %>>Select</option>
            <option value="50&ndash;75"<%= (typeof values !== 'undefined' && values.guestCount === "50&ndash;75") ? ' selected' : '' %>>50&ndash;75</option>
            <option value="76&ndash;100"<%= (typeof values !== 'undefined' && values.guestCount === "76&ndash;100") ? ' selected' : '' %>>76&ndash;100</option>
            <option value="101&ndash;150"<%= (typeof values !== 'undefined' && values.guestCount === "101&ndash;150") ? ' selected' : '' %>>101&ndash;150</option>
            <option value="151&ndash;200"<%= (typeof values !== 'undefined' && values.guestCount === "151&ndash;200") ? ' selected' : '' %>>151&ndash;200</option>
            <option value="201&ndash;250"<%= (typeof values !== 'undefined' && values.guestCount === "201&ndash;250") ? ' selected' : '' %>>201&ndash;250</option>
            <option value="More than 250"<%= (typeof values !== 'undefined' && values.guestCount === "More than 250") ? ' selected' : '' %>>More than 250</option>
            <option value="Not finalised yet"<%= (typeof values !== 'undefined' && values.guestCount === "Not finalised yet") ? ' selected' : '' %>>Not finalised yet</option>
          </select>
          <span class="lander-field__error" data-error-for="guestCount"><%= typeof errors !== 'undefined' && errors.guestCount ? errors.guestCount : '' %></span>
        </div>
      </div>
      <div class="field">
        <label for="f-vision">What are you imagining? <span class="opt">(optional)</span></label>
        <textarea id="f-vision" name="eventVision" rows="3" placeholder="The food, the atmosphere, the theme - anything you already have in mind."><%= typeof values !== 'undefined' && values.eventVision ? values.eventVision : '' %></textarea>
        <span class="lander-field__error" data-error-for="eventVision"><%= typeof errors !== 'undefined' && errors.eventVision ? errors.eventVision : '' %></span>
      </div>

      <!-- THE QUALIFIER — required. Server must reject submissions without budgetConfirmed=yes. -->
      <label class="check" for="f-threshold">
        <input id="f-threshold" name="budgetConfirmed" type="checkbox" required value="yes"<%= typeof values !== 'undefined' && values.budgetConfirmed === 'yes' ? ' checked' : '' %> />
        <span>Our celebration is planned at <strong>&#8377;3,500 per guest or above</strong>.</span>
      </label>
      <span class="lander-field__error" data-error-for="budgetConfirmed" style="margin-top:-12px"><%= typeof errors !== 'undefined' && errors.budgetConfirmed ? errors.budgetConfirmed : '' %></span>

      <input type="hidden" name="eventType" value="First Birthday" />
      <input type="hidden" name="pageVariant" value="v2-proof-first" />

      <div class="form__foot">
        <button class="btn btn--form" id="lander-submit" type="submit">Plan my child&rsquo;s first birthday <span class="btn__arrow" aria-hidden="true">&rarr;</span></button>
        <p id="lander-status" role="status" aria-live="polite"><%= typeof status !== 'undefined' ? status : '' %></p>
        <p class="fine fine--xs" style="text-align:center">By submitting, you agree that Virtuoso Catering House may contact you about your celebration. Your details are not shared.</p>
      </div>
    </form>
  </div>
</section>

