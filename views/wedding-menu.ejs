<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
<%- include('partials/head') %>
</head>
<body class="<%= bodyClass %>">

<%- include('partials/preloader') %>
<%- include('partials/cursor') %>
<%- include('partials/nav') %>
<%- include('partials/whatsapp-float') %>

<main id="smooth-wrapper">
<div id="smooth-content">

  <%#
    Built to the Virtuoso Visual Language System handoff for /wedding-menu.
    Typographic by decision: there is no photography on this page, so it does
    not wait on a photo library.

    Three sections the handoff specified are deliberately absent. Service
    formats with cover ranges, the five-step process with timings, and the
    indicative price bands were all confirmed inaccurate for this business on
    2026-08-19. Publishing them would have been an operational promise the
    site cannot keep, so they are not built rather than built with invented
    numbers. The handoff's own showPricing flag anticipated the pricing case.
  -%>

  <!-- HERO. The page's one sanctioned full-bleed grid break. -->
  <section class="wm-hero">
    <div class="wm-container">
      <div class="wm-hero__row">
        <div class="wm-hero__col">
          <%- include('partials/breadcrumb') %>
          <p class="wm-eyebrow wm-eyebrow--light">Wedding menu</p>
          <span class="wm-device wm-device--light" aria-hidden="true"></span>
          <%# The H1 names what the page is. The line it replaced, "A menu is
              composed for the room it is served in.", was the better sentence
              but carried none of the words anyone searches, and after the title
              tag this is the strongest signal the page has. It survives as the
              opening of the standfirst, where it reads the same and costs
              nothing. -%>
          <h1 class="wm-h1">Our pure veg Indian wedding catering menu, published in full.</h1>
        </div>
        <div class="wm-hero__aside">
          <p class="wm-hero__standfirst">A menu is composed for the room it is served in. <%= weddingMenu.summary %> This is the level of menu you can expect when you plan one with us: 212 dishes published on this list, and 32 more in the menu PDF. Take it as it is, or use it as the starting point for your own.</p>
          <div class="wm-actions" data-noprint>
            <a class="wm-action wm-action--light" href="#enquiry">Enquire</a>
            <button type="button" class="wm-action wm-action--light" data-menu-download-trigger data-cursor="hover">Download the menu (PDF)</button>
          </div>
          <%# Say the price of the download before it is clicked. A form that
              appears unannounced reads as a trick; one that was declared reads
              as an exchange. -%>
          <p class="wm-note wm-note--light" data-noprint style="margin-top:16px">Five details first, then the PDF downloads, with the two signature stations we hold back from this page. We open the enquiry form straight after.</p>
        </div>
      </div>

      <%# Descriptive of the menu, not of a single event. -%>
      <div class="wm-spec">
        <div class="wm-spec__cell">
          <p class="wm-spec__label">Courses</p>
          <p class="wm-spec__value"><%= weddingMenu.sections.length %></p>
        </div>
        <div class="wm-spec__cell">
          <p class="wm-spec__label">Dishes</p>
          <p class="wm-spec__value"><%= publicDishes %></p>
        </div>
        <div class="wm-spec__cell">
          <p class="wm-spec__label">Diet</p>
          <p class="wm-spec__value">Vegetarian</p>
        </div>
        <div class="wm-spec__cell">
          <p class="wm-spec__label">Kitchens</p>
          <p class="wm-spec__value">Italian · Asian · Modern Indian</p>
        </div>
      </div>
    </div>
  </section>

  <%# A bridge, not a section. "How a menu is built" and its three rows were
      removed on 2026-08-19; what stayed is the paragraph that carries the
      page's outbound links, since the alternative was a page that receives
      links and passes none on. weddingMenu.composition is now unused. -%>
  <section class="wm-section" id="approach">
    <div class="wm-container">
      <p class="wm-lead">The same menu can be cooked for a <a class="wm-link" href="/wedding-caterers-in-noida">wedding in Noida</a> and for a <a class="wm-link" href="/wedding-caterers-in-delhi">wedding in Delhi</a>. What would change is the kitchen built on site. If you want to see how we approach it, we have written up <a class="wm-link" href="/blog/how-luxury-wedding-caterers-build-custom-menu">how a bespoke menu gets built around one family</a> and <a class="wm-link" href="/blog/dos-and-donts-finalizing-wedding-menu">what tends to go wrong when one is finalised</a>. When the date is set, <a class="wm-link" href="#enquiry" data-inquire-trigger>send it to us with the venue and the covers</a>.</p>
    </div>
  </section>

  <!-- THE MENU, course by course -->
  <% weddingMenu.sections.forEach(function (section, i) { %>
  <section class="wm-section<%= i % 2 === 1 ? ' wm-section--vellum' : '' %>" id="section-<%= section.number %>">
    <div class="wm-container">
      <div class="wm-head">
        <div class="wm-head__row">
          <div>
            <p class="wm-eyebrow">Course <%= ['one','two','three','four','five'][i] || section.number %></p>
            <h2 class="wm-h2"><%= section.name %></h2>
          </div>
          <p class="wm-head__note"><%= section.groups.length %> stations</p>
        </div>
      </div>

      <% section.groups.forEach(function (group, gi) { %>
      <div class="wm-station">
        <%# The number is what makes a station read as a station. Without it a
            heading sat in the same face and the same size as the dish names
            under it, and 34 of them ran together as one list. -%>
        <span class="wm-station__no"><%= String(gi + 1).padStart(2, '0') %></span>
        <h3 class="wm-h3"><%= group.name %><% if (group.choose) { %> <span class="wm-note" style="display:inline">(choose any <%= group.choose %>)</span><% } %></h3>
        <% if (group.note) { %>
        <p class="wm-station__line"><%= group.note %></p>
        <% } %>

        <%# Gated stations describe themselves and stop. The dish list is absent
            from the HTML rather than hidden: showing a crawler what a visitor
            cannot see is cloaking, and hidden text carries no weight anyway. -%>
        <% if (group.gated) { %>
        <p class="wm-note" data-noprint>
          All <%= group.items.length %> dishes are in the menu PDF, which downloads once you have given us five details.
          <button type="button" class="wm-action" data-menu-download-trigger data-cursor="hover">Download the PDF</button>
        </p>
        <% } else { %>
        <ul class="wm-dishes">
          <% group.items.forEach(function (item) { %>
          <li class="wm-dish"><span class="wm-dish__name"><%= item %></span></li>
          <% }); %>
        </ul>
        <% } %>
      </div>
      <% }); %>
    </div>
  </section>
  <% }); %>

  <!-- DIETARY, in words. The page's one 1.6pt anchor rule sits here. -->
  <section class="wm-section" id="dietary">
    <div class="wm-container wm-split">
      <div class="wm-split__label">
        <p class="wm-eyebrow">Dietary</p>
        <span class="wm-device wm-device--static" aria-hidden="true"></span>
        <h2 class="wm-h2">A pure veg menu, stated in words rather than symbols.</h2>
      </div>
      <div class="wm-split__body">
        <div class="wm-rows wm-rows--anchor">
          <% weddingMenu.dietary.forEach(function (row) { %>
          <div class="wm-row">
            <span class="wm-row__label"><%= row.label %></span>
            <span class="wm-row__text"><%= row.text %></span>
          </div>
          <% }); %>
        </div>
        <p class="wm-note" style="margin-top:24px"><%= weddingMenu.closing %></p>
        <p class="wm-lead" style="margin-top:32px">This is the wedding menu. The rest of what we cook, from <a class="wm-link" href="/services">brand events to private dining and mixology</a>, is built the same way. To start on yours, <a class="wm-link" href="#enquiry" data-inquire-trigger>tell us about the event</a> or <a class="wm-link" href="/wedding-caterers-in-noida">read how we work in Noida</a>.</p>
      </div>
    </div>
  </section>

  <%#
    FAQ. Answers are 40 to 60 words, answer-first, each self-contained enough
    to be quoted on its own. Nothing here asserts a price, a lead time or a
    capacity. Defined once as data and rendered twice, into the visible markup
    and into the schema below, so the two cannot drift apart.
  -%>
  <% const weddingMenuFaq = [
    {
      q: 'What is included in a wedding catering menu?',
      a: 'A wedding catering menu covers more than the mains. This one runs grazing, circulated canapes, live counters, the buffet and dessert, across five courses and thirty-four stations. What usually differs between two quotes is not the dish list but how many of those stations are live.'
    },
    {
      q: 'How many dishes should an Indian wedding menu list have?',
      a: 'Fewer than most families expect, chosen better. This page publishes 212 across five courses, but no single function uses all of them. A menu is drawn from the list for each function, so the mehendi and the reception never repeat each other.'
    },
    {
      q: 'Can a full Indian wedding menu be pure veg?',
      a: 'Yes, and this page is the proof. Every one of the 212 dishes here is vegetarian as written. A veg wedding menu does not need to be a shorter menu, it needs a kitchen that treats it as the brief rather than as a constraint.'
    },
    {
      q: 'What is the difference between Jain, sattvic and vegetarian catering?',
      a: 'Jain and sattvic menus are prepared in separate vessels rather than adapted from the main menu. That distinction is the whole point, and it is the one most often skipped. Vegetarian, as used on this page, means every dish is written that way from the start.'
    }
  ]; %>
  <section class="wm-section wm-section--vellum" id="faq">
    <div class="wm-container wm-split">
      <div class="wm-split__label">
        <p class="wm-eyebrow">Questions</p>
        <span class="wm-device wm-device--static" aria-hidden="true"></span>
        <h2 class="wm-h2">What families ask before they book.</h2>
      </div>
      <div class="wm-split__body">
        <% weddingMenuFaq.forEach(function (item) { %>
        <div class="wm-station">
          <h3 class="wm-h3"><%= item.q %></h3>
          <p class="wm-lead" style="margin-top:16px"><%= item.a %></p>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "@id": canonicalUrl + '#faq',
    "mainEntity": weddingMenuFaq.map(function (item) {
      return {
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": { "@type": "Answer", "text": item.a }
      };
    })
  }) %>
  </script>

  <!-- ENQUIRY -->
  <section class="wm-section wm-section--forest" id="enquiry">
    <div class="wm-container wm-split">
      <div class="wm-split__label">
        <p class="wm-eyebrow wm-eyebrow--light">Enquire</p>
        <span class="wm-device wm-device--light wm-device--static" aria-hidden="true"></span>
        <h2 class="wm-h2">Send the date, the venue and the covers.</h2>
        <p class="wm-lead" style="margin-top:24px">We will come back with a menu written for the event rather than a rate card.</p>
        <p style="border-top:0.4pt solid oklch(97% 0.01 85 / 18%);padding-top:24px;margin-top:24px">
          <a class="wm-action wm-action--light" style="border:0;font-family:var(--font-display,'Cormorant Garamond',serif);font-size:1.5rem;text-transform:none;letter-spacing:0" href="mailto:<%= business.email %>"><%= business.email %></a>
        </p>
      </div>
      <div class="wm-split__body">
        <%# Posts to the same drawer the rest of the site uses, so one endpoint
            and one validator serve every lead route. -%>
        <button type="button" class="wm-action wm-action--light" data-inquire-trigger data-cursor="hover">Start an enquiry</button>
      </div>
    </div>
  </section>

  <!-- Menu structured data. Sections nest as MenuSection, dishes as MenuItem.
       Gated stations are named but carry no items, so the markup describes the
       page rather than the PDF. No price is declared anywhere. -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Menu",
    "@id": canonicalUrl + '#menu',
    "name": weddingMenu.title,
    "description": weddingMenu.summary,
    "url": canonicalUrl,
    "inLanguage": "en-IN",
    "provider": { "@id": siteUrl + '/#organization' },
    "hasMenuSection": weddingMenu.sections.map(function (section) {
      return {
        "@type": "MenuSection",
        "name": section.name,
        "hasMenuSection": section.groups.map(function (group) {
          return {
            "@type": "MenuSection",
            "name": group.name,
            "description": group.note || undefined,
            "hasMenuItem": group.gated ? undefined : group.items.map(function (item) {
              return { "@type": "MenuItem", "name": item, "suitableForDiet": "https://schema.org/VegetarianDiet" };
            })
          };
        })
      };
    })
  }) %>
  </script>

<%- include('partials/footer') %>
</div>
</main>

<%- include('partials/scripts') %>
</body>
</html>
