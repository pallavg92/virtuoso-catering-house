  // Whichever happens first.
  ['pointerdown', 'keydown', 'touchstart', 'scroll'].forEach(function (evt) {
    window.addEventListener(evt, loadVendors, { once: true, passive: true });
  });
  if (document.readyState === 'complete') setTimeout(loadVendors, 2000);
  else window.addEventListener('load', function () { setTimeout(loadVendors, 2000); });
})();
</script>
