<script>
(function () {
  /* ------------------------------------------------------------------
     CRM HOOK
     Set LEAD_ENDPOINT to your CRM / webhook URL. The form POSTs JSON
     using the same field names as the first-birthday lander:
     { name, phone, email, partyType, eventDate, guestCount, eventVision,
       budgetConfirmed, eventType, pageVariant, utm_*, gclid, fbclid,
       page_url, submitted_at }
     While LEAD_ENDPOINT is empty the form shows the thank-you state
     without sending anything (preview mode).
     ------------------------------------------------------------------ */
  // Posts to our own server, which emails the enquiry and reports the
  // Lead to Meta from the server with the same event id the pixel uses
  // below, so Meta counts one conversion rather than two.
  var LEAD_ENDPOINT = "/lp/diwali-2026";
  var PRICE_PER_GUEST = 3500;
  var DIWALI = new Date("2026-11-08T00:00:00+05:30");

  /* Countdown */
  var days = Math.ceil((DIWALI - new Date()) / 86400000);
  var cd = document.getElementById("countdown");
  if (days > 1) cd.textContent = "Diwali is Sunday, 8 November · " + days + " days to plan";
  else if (days === 1) cd.textContent = "Diwali is tomorrow";
  else if (days === 0) cd.textContent = "Happy Diwali";
  else cd.remove();

  /* Party date: any day from today onwards */
  var dateEl = document.getElementById("eventDate");
  var today = new Date(); today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
  dateEl.min = today.toISOString().slice(0, 10);

  /* Capture UTM / click IDs */
  try {
    var qs = new URLSearchParams(location.search);
    ["utm_source","utm_medium","utm_campaign","utm_content","utm_term","gclid","fbclid"].forEach(function (k) {
      var v = qs.get(k); if (v) document.getElementById(k).value = v;
    });
  } catch (e) {}

  /* Validation */
  var form = document.getElementById("lander-form");
  function setErr(wrapId, errId, msg) {
    document.getElementById(wrapId).classList.toggle("invalid", !!msg);
    document.getElementById(errId).textContent = msg || "";
    return !msg;
  }
  function validate() {
    var ok = true, first = null;
    function check(cond, wrapId, errId, msg, el) {
      if (!setErr(wrapId, errId, cond ? "" : msg)) { ok = false; if (!first) first = el; }
    }
    var name = document.getElementById("name");
    check(name.value.trim().length > 1, "f-name", "name-err", "Enter your name.", name);
    var phone = document.getElementById("phone");
    var digits = phone.value.replace(/\D/g, "").replace(/^(91|0)(?=\d{10}$)/, "");
    check(/^[6-9]\d{9}$/.test(digits), "f-phone", "phone-err", "Enter a 10-digit mobile number.", phone);
    check(!!form.querySelector('input[name="partyType"]:checked'), "f-type", "type-err", "Choose office or home.", document.getElementById("type-office"));
    check(!!dateEl.value && dateEl.value >= dateEl.min, "f-date", "date-err", "Choose the date of your party.", dateEl);
    var guests = document.getElementById("guestCount");
    check(!!guests.value, "f-guests", "guest-err", "Choose how many guests you expect.", guests);
    var ack = document.getElementById("budgetConfirmed");
    check(ack.checked, "f-ack", "ack-err", "Please confirm the pricing to check your date.", ack);
    if (first) first.focus();
    return ok;
  }

  form.addEventListener("submit", function (ev) {
    ev.preventDefault();
    document.getElementById("lander-status").textContent = "";
    if (!validate()) return;

    var data = {};
    new FormData(form).forEach(function (v, k) { data[k] = typeof v === "string" ? v.trim() : v; });
    data.phone = "+91" + data.phone.replace(/\D/g, "").replace(/^(91|0)(?=\d{10}$)/, "");
    data.budgetConfirmed = "yes";
    data.page_url = location.href;
    data.submitted_at = new Date().toISOString();

    var opt = document.getElementById("guestCount").selectedOptions[0];
    var minGuests = parseInt(opt.getAttribute("data-min"), 10) || 50;

    var btn = document.getElementById("lander-submit");
    var label = btn.innerHTML;
    btn.disabled = true; btn.textContent = "Sending…";

    var send = fetch(LEAD_ENDPOINT, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) })
      .then(function (r) {
        if (!r.ok) throw new Error(r.status);
        return r.json().catch(function () { return {}; });
      })
      .then(function (body) {
        if (body && body.ok === false) throw new Error("rejected");
        return body || {};
      });

    send.then(function (body) {
      window.dispatchEvent(new CustomEvent("vch:lead", { detail: data }));
      try { fbq("track", "Lead", { content_name: "Diwali 2026", value: minGuests * PRICE_PER_GUEST, currency: "INR" }, body.eventId ? { eventID: body.eventId } : undefined); } catch (e) {}
      try { gtag("event", "generate_lead", { event_category: "diwali_2026", value: minGuests * PRICE_PER_GUEST, currency: "INR" }); } catch (e) {}
      var firstName = data.name.split(/\s+/)[0];
      document.getElementById("done-title").textContent = "Thank you, " + firstName + ". Your enquiry is in.";
      var dateText = new Date(data.eventDate + "T12:00:00").toLocaleDateString("en-IN", { weekday: "short", day: "numeric", month: "short" });
      document.getElementById("done-text").textContent = "One person from Virtuoso will call you on " +
        data.phone.replace(/^\+91(\d{5})(\d{5})$/, "+91 $1 $2") + " to confirm " +
        dateText + " and talk through your evening.";
      document.getElementById("form-view").hidden = true;
      var done = document.getElementById("done-view");
      done.hidden = false; done.focus();
    }).catch(function () {
      document.getElementById("lander-status").textContent = "We couldn't send your enquiry. Check your connection and try again, or call +91 87009 15463.";
    }).finally(function () {
      btn.disabled = false; btn.innerHTML = label;
    });
  });

  document.getElementById("again").addEventListener("click", function () {
    form.reset();
    document.getElementById("done-view").hidden = true;
    document.getElementById("form-view").hidden = false;
    document.getElementById("name").focus();
  });

  /* Hide the mobile bar while the form is on screen */
  var bar = document.getElementById("mbar");
  if ("IntersectionObserver" in window) {
    new IntersectionObserver(function (es) {
      es.forEach(function (e) { bar.classList.toggle("away", e.isIntersecting); });
    }, { threshold: 0.1 }).observe(form);
  }
})();
</script>

</body>
</html>
