<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Diwali party catering in Delhi NCR — Virtuoso Catering House</title>
<meta name="description" content="Diwali party catering for offices and homes across Delhi NCR. Live counters, a mixology bar and a menu designed around your evening. 50 guests or more, from ₹3,500 a guest. One conversation, one written plan within 24 hours." />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Virtuoso Catering House" />
<meta property="og:title" content="Diwali parties in Delhi NCR — Virtuoso Catering House" />
<meta property="og:description" content="This Diwali, be a guest at your own party. Offices and homes, 50 guests or more. Check if your date is free." />
<meta property="og:image" content="https://www.virtuosocatering.com/images/hero-candlelit-florals.jpg" />
<meta property="og:image:alt" content="A candlelit Virtuoso dinner setup with red florals" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="robots" content="noindex" />
<link rel="preload" href="/fonts/cormorant-300.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/cormorant-italic-400.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/worksans-300-400-500-600.woff2" as="font" type="font/woff2" crossorigin />

<style>
@font-face{font-family:'Cormorant Garamond';font-style:normal;font-weight:300 600;font-display:swap;src:url('/fonts/cormorant-300.woff2') format('woff2')}
@font-face{font-family:'Cormorant Garamond';font-style:italic;font-weight:400;font-display:swap;src:url('/fonts/cormorant-italic-400.woff2') format('woff2')}
@font-face{font-family:'Work Sans';font-style:normal;font-weight:300 600;font-display:swap;src:url('/fonts/worksans-300-400-500-600.woff2') format('woff2')}

/* ============================================================
   VIRTUŌSO — DIWALI 2026 LANDER
   Built on the first-birthday lander's system (same tokens, type,
   components). Order: hero → names → the work → threshold + form →
   proof → two ways to host → contrast → the evening → how it works
   → FAQ → closing. One CTA target throughout (#lander-form).
   ============================================================ */
:root{
  --ink:#17100B;
  --ink-2:#3D342D;
  --ink-3:#5B5048;
  --ink-4:#8A7A6A;
  --page:#FAF6EE;
  --card:#FEFCF7;
  --band:#F3EDE0;
  --forest:#101F10;
  --old:#3D342D;
  --old-ink:#D9D2C4;
  --old-muted:#A89C8C;
  --sage-wash:#E4E8DC;
  --cta:#C9873A;
  --cta-hover:#E8C98A;
  --cta-deep:#935A11;
  --gold-text:#E8C98A;
  --error:#8B4A2F;
  --hair:rgba(23,16,11,.1);
  --hair-2:rgba(23,16,11,.12);
  --field:rgba(23,16,11,.18);
  --serif:'Cormorant Garamond',Georgia,serif;
  --sans:'Work Sans',Arial,Helvetica,sans-serif;
  --pad:clamp(20px,5vw,48px);
  --ease:cubic-bezier(.4,0,.2,1);
}

*{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{margin:0;background:var(--page);color:var(--ink);font-family:var(--sans);font-weight:300;-webkit-font-smoothing:antialiased;overflow-x:hidden}
img{display:block;max-width:100%;height:auto;color:transparent}
a{color:var(--ink);text-decoration:none;transition:background 150ms var(--ease),color 150ms var(--ease)}
a:hover{color:var(--cta-deep)}
:focus-visible{outline:2px solid var(--cta-deep);outline-offset:2px}
::selection{background:var(--sage-wash)}
input[type=checkbox]{accent-color:var(--cta-deep)}
strong{font-weight:500}
[hidden]{display:none !important}

.wrap{max-width:1160px;margin:0 auto;width:100%;padding-left:var(--pad);padding-right:var(--pad)}
.band{padding-top:clamp(48px,7vw,104px);padding-bottom:clamp(48px,7vw,104px)}
.band--card{background:var(--card);border-top:1px solid var(--hair)}
.stack{display:flex;flex-direction:column}

/* type */
.eyebrow{font-size:12px;line-height:1.3;font-weight:500;letter-spacing:.16em;text-transform:uppercase;color:var(--cta-deep);margin:0}
.h1{font-family:var(--serif);font-weight:300;font-size:clamp(40px,2.2rem + 2.4vw,72px);line-height:1.04;letter-spacing:-.01em;margin:0;max-width:20ch;text-wrap:pretty}
.h1 em{font-style:italic;font-weight:400;color:var(--gold-text)}
.h2{font-family:var(--serif);font-weight:300;font-size:clamp(30px,1.6rem + 1.6vw,48px);line-height:1.08;letter-spacing:-.01em;margin:0;text-wrap:pretty}
.h3{font-size:18px;line-height:1.3;font-weight:500;margin:0}
.lede{font-size:clamp(16px,.95rem + .3vw,19px);line-height:1.5;margin:0;max-width:52ch;text-wrap:pretty}
.p{font-size:16px;line-height:1.6;color:var(--ink-2);margin:0;max-width:60ch;text-wrap:pretty}
.p--s{font-size:15px}
.fine{font-size:14px;line-height:1.6;color:var(--ink-3);margin:0}
.fine--xs{font-size:12px;color:var(--ink-3)}
mark.hl{background:var(--sage-wash);color:var(--forest);font-weight:500;padding:2px 8px;border-radius:3px;-webkit-box-decoration-break:clone;box-decoration-break:clone}

/* the action */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:12px;min-height:58px;padding:17px 34px;border-radius:6px;border:0;background:var(--cta);color:var(--ink);font-family:var(--sans);font-size:16px;font-weight:600;letter-spacing:.02em;cursor:pointer;transition:background 150ms var(--ease),color 150ms var(--ease)}
.btn:hover{background:var(--cta-hover);color:var(--ink)}
.btn--form{width:100%}
.btn--form:hover{background:var(--cta-deep);color:var(--card)}
.btn[disabled]{opacity:.7;cursor:progress}
.btn__arrow{font-size:20px;line-height:1}

/* top bar */
.topbar{display:flex;align-items:center;justify-content:space-between;gap:16px;padding-top:14px;padding-bottom:14px}
.wordmark{font-family:var(--serif);font-weight:300;font-size:20px;line-height:1.1;letter-spacing:.09em;text-transform:uppercase;display:block}
.wordmark__sub{font-size:10px;line-height:1.3;font-weight:400;letter-spacing:.2em;text-transform:uppercase;color:var(--ink-3);display:block;margin-top:2px}
.tel{display:inline-flex;align-items:center;min-height:44px;font-size:13px;font-weight:500;letter-spacing:.06em}

/* hero */
.hero{position:relative;isolation:isolate;background-color:var(--forest);background-image:url('https://www.virtuosocatering.com/images/virtuoso-catering-house-bespoke-menus-service.jpg');background-size:cover;background-position:70% 40%}
.hero::before{content:"";position:absolute;inset:0;z-index:0;background:linear-gradient(100deg,rgba(11,20,11,.96) 0%,rgba(11,20,11,.9) 40%,rgba(11,20,11,.6) 70%,rgba(11,20,11,.3) 100%)}
.hero__inner{position:relative;z-index:1;display:flex;flex-direction:column;gap:14px;padding-top:clamp(28px,6vw,80px);padding-bottom:clamp(24px,5vw,64px)}
.hero .eyebrow{font-size:13px;letter-spacing:.18em;color:var(--gold-text)}
.hero .h1{color:var(--card)}
.hero .lede{color:#EFE8D8}
.hero .btn{box-shadow:0 10px 30px -10px rgba(0,0,0,.55)}
.hero__proof{font-size:14px;line-height:1.5;color:#EFE8D8;margin:0;max-width:46ch}
.hero__proof strong{color:var(--card)}
.hero__proof span{color:#C9C2B4}
.countdown{display:inline-flex;align-items:center;gap:10px;font-size:13px;line-height:1.4;font-weight:500;letter-spacing:.06em;color:var(--gold-text);margin:0}
.countdown::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--cta);box-shadow:0 0 0 4px rgba(201,135,58,.25)}
@media (max-width:759px){.hero .lede{font-size:16px !important;line-height:1.45}.hero__inner .stack{gap:8px}.hero__proof{font-size:13px}}

/* names */
.names{background:var(--card);border-bottom:1px solid var(--hair)}
.names__row{display:flex;flex-wrap:wrap;gap:12px 40px;align-items:baseline;padding-top:22px;padding-bottom:22px}
.names p{font-size:13px;line-height:1.6;margin:0;color:var(--ink-2)}
.names .k{font-weight:500;letter-spacing:.14em;text-transform:uppercase;font-size:11px;color:var(--ink-3);margin-right:10px}

/* images */
.frame{overflow:hidden;border-radius:4px;background:var(--band)}
.frame img{width:100%;height:100%;object-fit:cover}
.frame--32{aspect-ratio:3/2}
.frame--11{aspect-ratio:1/1}
.work{display:grid;grid-template-columns:1fr;gap:clamp(12px,2vw,24px)}
.work figure{margin:0;display:flex;flex-direction:column;gap:10px}
.work figcaption{font-size:15px;line-height:1.5;color:var(--ink-2)}
.work figcaption strong{color:var(--ink)}

/* threshold + form */
.enquiry{background:var(--band);border-top:1px solid var(--hair);border-bottom:1px solid var(--hair)}
.enquiry__grid{display:grid;grid-template-columns:1fr;gap:clamp(28px,4vw,64px);align-items:start;padding-top:clamp(40px,6vw,88px);padding-bottom:clamp(40px,6vw,88px)}
.threshold{background:var(--forest);color:var(--card);border-radius:6px;padding:clamp(22px,3vw,32px);display:flex;flex-direction:column;gap:12px}
.threshold .eyebrow{color:var(--gold-text)}
.threshold__price{font-family:var(--serif);font-weight:400;font-size:clamp(24px,1.2rem + 1vw,32px);line-height:1.2;margin:0;text-wrap:pretty}
.threshold__price span{color:var(--gold-text);white-space:nowrap}
.threshold .p{color:#D9D2C4;font-size:15px}
.form{background:var(--card);border:1px solid var(--hair);border-radius:8px;box-shadow:0 1px 2px rgba(23,16,11,.06),0 14px 40px -20px rgba(23,16,11,.25);padding:clamp(20px,3vw,32px);display:flex;flex-direction:column;gap:18px;scroll-margin-top:16px}
.row{display:grid;grid-template-columns:1fr;gap:14px}
.field{display:flex;flex-direction:column;gap:6px;min-width:0;border:0;margin:0;padding:0}
.field label,.field legend{font-size:13px;line-height:1.3;font-weight:500;color:var(--ink-2);padding:0}
.field .opt{font-weight:300;color:var(--ink-3)}
.field input,.field select,.field textarea{width:100%;min-height:50px;padding:12px 14px;font-family:var(--sans);font-size:16px;line-height:1.5;font-weight:300;color:var(--ink);background:var(--page);border:1px solid var(--field);border-radius:6px;appearance:none;-webkit-appearance:none;transition:border-color 150ms var(--ease)}
.field select{background-image:linear-gradient(45deg,transparent 50%,var(--ink-3) 50%),linear-gradient(135deg,var(--ink-3) 50%,transparent 50%);background-position:calc(100% - 20px) 50%,calc(100% - 15px) 50%;background-size:5px 5px;background-repeat:no-repeat;padding-right:40px}
.field input[type=date]{display:block;min-width:0}
.field textarea{min-height:88px;line-height:1.6;resize:vertical}
.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--cta-deep);outline:2px solid var(--cta-deep);outline-offset:2px}
.seg{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:6px}
.seg input{position:absolute;left:0;top:0;width:1px;height:1px;opacity:0;pointer-events:none}
.seg label{display:flex;align-items:center;justify-content:center;min-height:50px;padding:10px 12px;border:1px solid var(--field);border-radius:6px;background:var(--page);font-size:15px;font-weight:400;color:var(--ink);text-align:center;cursor:pointer;transition:background 150ms var(--ease),border-color 150ms var(--ease),color 150ms var(--ease)}
.seg input:checked + label{background:var(--forest);border-color:var(--forest);color:var(--card)}
.seg input:focus-visible + label{outline:2px solid var(--cta-deep);outline-offset:2px}
.check{display:flex;gap:12px;align-items:flex-start;padding:14px 16px;background:var(--band);border-radius:6px;cursor:pointer;border:1px solid transparent}
.check input{width:22px;height:22px;margin:1px 0 0;flex:none;cursor:pointer}
.check span{font-size:15px;line-height:1.5}
.check.invalid{border-color:var(--error)}
.lander-field__error{font-size:13px;line-height:1.5;color:var(--error)}
.lander-field__error:not(:empty)::before{content:"! ";font-weight:600}
.lander-field__error:empty{display:none}
.field.invalid input,.field.invalid select,.field.invalid textarea,.field.invalid .seg label{border-color:var(--error);border-width:2px}
.form__foot{display:flex;flex-direction:column;gap:12px;padding-top:4px}
#lander-status{font-size:15px;line-height:1.5;color:var(--error);margin:0}
#lander-status:empty{display:none}
.done{display:flex;flex-direction:column;gap:14px}
.done .h2{font-size:clamp(28px,1.4rem + 1.2vw,40px)}
.linkish{align-self:flex-start;background:none;border:0;padding:0 0 3px;font:500 14px/1 var(--sans);color:var(--cta-deep);border-bottom:1px solid currentColor;cursor:pointer}

/* boundary note */
.boundary{display:flex;flex-direction:column;gap:12px;padding:4px 0 4px 22px;border-left:3px solid var(--cta);max-width:46ch}
.boundary__lead{font-family:var(--serif);font-weight:400;font-style:italic;font-size:clamp(21px,1.05rem + .7vw,26px);line-height:1.3;color:var(--ink);margin:0;text-wrap:pretty}

/* proof */
.case{display:grid;grid-template-columns:1fr;gap:clamp(24px,4vw,56px);align-items:start}
.brief{margin:0;padding:0 0 0 22px;border-left:3px solid var(--cta);display:flex;flex-direction:column;gap:10px}
.brief p{font-family:var(--serif);font-weight:400;font-style:italic;font-size:clamp(22px,1.1rem + 1vw,30px);line-height:1.25;margin:0;text-wrap:pretty}
.brief footer{font-size:13px;line-height:1.5;color:var(--ink-3)}
.quote{margin:0;background:var(--sage-wash);border-radius:8px;padding:clamp(20px,3vw,28px);display:flex;flex-direction:column;gap:12px}
.quote p{font-size:clamp(17px,1rem + .35vw,20px);line-height:1.55;margin:0;color:var(--forest);text-wrap:pretty}
.quote footer{font-size:14px;line-height:1.5;color:var(--ink-2);font-weight:500}
.gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(10px,1.5vw,16px)}
.gallery figure{margin:0;display:flex;flex-direction:column;gap:8px;min-width:0}
.gallery .wide{grid-column:1 / -1}
.gallery figcaption{font-size:13px;line-height:1.45;color:var(--ink-3)}

/* two ways to host */
.hosts{display:grid;grid-template-columns:1fr;gap:clamp(16px,2vw,24px)}
.host{background:var(--card);border:1px solid var(--hair);border-radius:8px;padding:clamp(24px,3vw,36px);display:flex;flex-direction:column;gap:14px}
.host ul{list-style:none;margin:4px 0 0;padding:0;display:flex;flex-direction:column}
.host li{padding:11px 0;border-top:1px solid var(--hair-2);font-size:15px;line-height:1.5;color:var(--ink-2);display:flex;gap:12px}
.host li span{color:var(--cta-deep);flex:none}

/* contrast */
.vs{display:grid;grid-template-columns:1fr;gap:clamp(16px,2vw,24px)}
.vs__col{border-radius:8px;padding:clamp(24px,3vw,36px);display:flex;flex-direction:column;gap:18px}
.vs__col--old{background:var(--old);color:var(--old-ink)}
.vs__col--old .eyebrow{color:var(--old-muted)}
.vs__col--new{background:var(--forest);color:var(--card);box-shadow:0 20px 50px -24px rgba(16,31,16,.6)}
.vs__col--new .eyebrow{color:var(--gold-text)}
.vs ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px;font-size:17px;line-height:1.45}
.vs li{display:flex;gap:12px}
.vs li span{flex:none}
.vs__col--old li span{color:var(--old-muted)}
.vs__col--new li span{color:var(--gold-text)}

/* how it works */
.steps{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr;gap:clamp(20px,3vw,32px)}
.steps li{display:flex;flex-direction:column;gap:10px;padding-top:16px;border-top:2px solid var(--cta)}
.steps .n{font-family:var(--serif);font-size:34px;line-height:1;font-weight:300;color:var(--cta-deep)}

/* faq */
.faq{margin:0;display:flex;flex-direction:column}
.faq>div{padding:20px 0;border-top:1px solid var(--hair-2);display:flex;flex-direction:column;gap:8px}
.faq>div:last-child{border-bottom:1px solid var(--hair-2)}
.faq dt{font-size:18px;line-height:1.35;font-weight:500;margin:0}
.faq dd{font-size:16px;line-height:1.6;color:var(--ink-2);margin:0}

/* closing + footer */
.close{background:var(--forest);color:var(--card)}
.close__inner{display:flex;flex-direction:column;gap:22px;align-items:flex-start;padding-top:clamp(56px,8vw,120px);padding-bottom:clamp(56px,8vw,120px)}
.close .h2{color:var(--card);font-size:clamp(34px,1.8rem + 2vw,56px);line-height:1.06;max-width:20ch}
.close .p{color:#D9D2C4;font-size:17px;line-height:1.55;max-width:52ch}
.close .fine{color:var(--old-muted)}
.foot{border-top:1px solid var(--hair);display:flex;flex-wrap:wrap;gap:8px 28px;align-items:center;padding-top:24px;padding-bottom:40px}
.foot a{display:inline-flex;align-items:center;min-height:44px;font-size:14px;color:var(--ink-2)}
.foot a.u{text-decoration:underline;text-underline-offset:3px}

/* mobile action bar */
.mbar{display:none}
@media (max-width:759px){
  body{padding-bottom:84px}
  .mbar{display:flex;gap:10px;position:fixed;left:0;right:0;bottom:0;z-index:10;padding:10px 16px calc(10px + env(safe-area-inset-bottom,0px));background:rgba(16,31,16,.96);border-top:1px solid rgba(232,201,138,.25);transition:transform .3s var(--ease)}
  .mbar.away{transform:translateY(110%)}
  .mbar .btn{flex:1;min-height:52px;padding:12px 16px;font-size:15px}
  .mbar .call{flex:0 0 auto;background:transparent;color:var(--card);border:1px solid rgba(232,201,138,.5)}
}

.split{display:grid;grid-template-columns:1fr;gap:clamp(28px,4vw,64px);align-items:start}

@media (min-width:760px){
  .work{grid-template-columns:repeat(3,1fr)}
  .enquiry__grid,.case,.vs,.split,.hosts{grid-template-columns:1fr 1fr}
  .row{grid-template-columns:1fr 1fr}
  .steps{grid-template-columns:repeat(2,1fr)}
}
@media (min-width:1040px){
  .steps{grid-template-columns:repeat(4,1fr)}
  .enquiry__grid{grid-template-columns:5fr 7fr}
  .split{grid-template-columns:5fr 7fr}
}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition-duration:.001ms !important}}
</style>

