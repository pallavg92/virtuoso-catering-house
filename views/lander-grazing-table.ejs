<body>
<%
  // Every photograph is from a real, previous Virtuōso event.
  const work = [
    { src: '/images/virtuoso-catering-house-grazing-table-bath-body-works-2026.jpg', alt: 'An all-gold grazing table with a truffle tower, macarons and canapés', cap: 'The all-gold grazing table for Bath &amp; Body Works, Promenade Mall, 2026.' },
    { src: '/images/blog/cheese-board/virtuoso-catering-house-grazing-table-delhi-ncr-2.jpg', alt: 'A round board of cheeses, fruit, olives and crackers surrounded by small bites and candles', cap: 'Fromagerie, fruit and olives around a round board, Delhi NCR.' },
    { src: '/images/virtuoso-catering-house-fromagerie-platter-ferrari-track-day-2026-2.jpg', alt: 'A candlelit fromagerie table in a dark room', cap: 'Candlelit fromagerie at La Esperienza Ferrari, Buddh International Circuit, 2026.' },
    { src: '/images/blog/cheese-board/virtuoso-catering-house-grazing-table-delhi-ncr-5.jpg', alt: 'A gloved hand placing caprese skewers into a wooden stand', cap: 'Caprese skewers set into place by hand, Delhi NCR.' },
