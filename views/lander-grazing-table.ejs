    <form class="form" id="lander-form" method="post" action="/lp/grazing-table">
      <div class="row">
        <div class="field">
          <label for="f-name">Your name</label>
          <input id="f-name" name="name" type="text" required autocomplete="name" value="<%= v.name || '' %>" />
          <span class="lander-field__error" data-error-for="name"><%= e.name || '' %></span>
        </div>
        <div class="field">
          <label for="f-phone">Mobile / WhatsApp</label>
          <input id="f-phone" name="phone" type="tel" required inputmode="tel" autocomplete="tel" value="<%= v.phone || '' %>" />
          <span class="lander-field__error" data-error-for="phone"><%= e.phone || '' %></span>
        </div>
      </div>
      <div class="field">
        <label for="f-email">Email</label>
        <input id="f-email" name="email" type="email" required inputmode="email" autocomplete="email" value="<%= v.email || '' %>" />
        <span class="lander-field__error" data-error-for="email"><%= e.email || '' %></span>
      </div>
      <div class="row">
        <div class="field">
          <label for="f-date">Date <span class="opt">(if known)</span></label>
          <input id="f-date" name="eventDate" type="date" value="<%= v.eventDate || '' %>" />
          <span class="lander-field__error" data-error-for="eventDate"><%= e.eventDate || '' %></span>
        </div>
        <div class="field">
          <label for="f-guests">Guests</label>
          <select id="f-guests" name="guestCount" required>
            <option value=""<%= sel('') %>>Select</option>
            <% ['50–75', '76–100', '101–150', '151–200', '201–300', 'More than 300', 'Not finalised yet'].forEach(function (o) { %>
            <option value="<%= o %>"<%= sel(o) %>><%= o %></option>
            <% }); %>
          </select>
          <span class="lander-field__error" data-error-for="guestCount"><%= e.guestCount || '' %></span>
        </div>
      </div>
      <div class="field">
        <label for="f-location">Where is the party?</label>
        <input id="f-location" name="eventLocation" type="text" autocomplete="address-level2" placeholder="Noida, Gurugram, South Delhi&hellip;" value="<%= v.eventLocation || '' %>" />
      </div>
      <div class="field">
        <label for="f-vision">What are you imagining? <span class="opt">(optional)</span></label>
        <textarea id="f-vision" name="eventVision" rows="3" placeholder="The occasion, your palette, the vibe of the party, anything you already have in mind."><%= v.eventVision || '' %></textarea>
      </div>

      <!-- THE QUALIFIER, required. The server rejects a submission without budgetConfirmed=yes. -->
      <label class="check" for="f-threshold">
        <input id="f-threshold" name="budgetConfirmed" type="checkbox" required value="yes"<%= v.budgetConfirmed === 'yes' ? ' checked' : '' %> />
        <span>Our grazing table is planned at <strong>&#8377;1,50,000 or above</strong>, for 50 guests or more.</span>
      </label>
      <span class="lander-field__error" data-error-for="budgetConfirmed" style="margin-top:-12px"><%= e.budgetConfirmed || '' %></span>

      <input type="hidden" name="eventType" value="Grazing Table" />
      <input type="hidden" name="pageVariant" value="grazing-v1" />

      <div class="form__foot">
