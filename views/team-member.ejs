<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
<%- include('partials/head') %>
</head>
<body class="<%= bodyClass %>">

<%- include('partials/preloader') %>
<%- include('partials/cursor') %>
<%- include('partials/nav') %>
<%- include('partials/whatsapp-float') %>
<%- include('partials/popups') %>

<main id="smooth-wrapper">
<div id="smooth-content">

  <!-- INTRO -->
  <section class="page-intro page-intro--short">
    <div class="page-intro__media" data-parallax>
      <img src="<%= member.image %>" alt="<%= member.name %>, <%= member.role %> of Virtuoso Catering House" loading="eager">
    </div>
    <div class="page-intro__scrim"></div>
    <div class="page-intro__content container">
      <%- include('partials/breadcrumb') %>
      <span class="eyebrow eyebrow--light reveal-up"><%= member.role %></span>
      <h1 class="page-intro__title reveal-up"><%= member.name %></h1>
    </div>
  </section>

  <!-- BIO -->
  <section class="blog-post section section--ivory">
    <div class="container">
      <div class="blog-post__prose">
        <p class="blog-post__copy blog-post__copy--lead reveal-up"><%= member.bio %></p>
        <p class="blog-post__copy reveal-up">
          <%= member.name %> is based at Virtuoso Catering House in <%= business.addressLocality %>,
          and can be reached through <a href="/contact" class="link-underline">the enquiry page</a>.
        </p>
        <p class="blog-post__copy reveal-up">
          <a href="<%= member.linkedin %>" target="_blank" rel="noopener me" class="link-underline">Connect on LinkedIn</a>
        </p>
      </div>
    </div>
  </section>

  <!-- AUTHORED POSTS. This is what makes the page an entity hub rather than a
       bio: every article attributed to this person links back here, and this
       page links out to every one of them. -->
  <% if (authoredPosts && authoredPosts.length) { %>
  <section class="section section--ivory">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow reveal-up">Writing</span>
        <h2 class="section-title reveal-up">Articles by <%= member.name %></h2>
        <span class="section-header__line"></span>
      </div>
      <div class="blog-post__prose">
        <ul class="landing-list">
          <% authoredPosts.forEach(function(post) { %>
          <li class="landing-list__item reveal-up">
            <a href="<%= post.url || ('/blog/' + post.slug) %>" class="link-underline"><%= post.title %></a>
            <% if (post.date) { %>
            <br><time datetime="<%= post.date %>"><%= new Date(post.date).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %></time>
            <% } %>
          </li>
          <% }); %>
        </ul>
      </div>
    </div>
  </section>
  <% } %>

  <!-- The canonical Person node for this individual. Its @id is referenced by
       the About page and by the `author` field of every post they wrote, so
       all authorship signals resolve to this one entity. -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": siteUrl + '/team/' + member.slug + '#person',
    "name": member.name,
    "jobTitle": member.role,
    "description": member.bio,
    "image": siteUrl + member.image,
    "url": siteUrl + '/team/' + member.slug,
    "knowsAbout": member.knowsAbout,
    "worksFor": { "@id": siteUrl + '/#organization' },
    "sameAs": [member.linkedin]
  }) %>
  </script>

  <!-- CTA BANNER -->
  <section class="cta-banner section section--wine">
    <div class="container cta-banner__inner">
      <h2 class="cta-banner__title reveal-up">Planning Something<br>Worth Remembering?</h2>
      <button type="button" class="btn btn--gold-outline" data-magnetic data-inquire-trigger data-cursor="hover"><span>Start an Inquiry</span></button>
    </div>
  </section>

<%- include('partials/footer') %>
</div>
</main>

<%- include('partials/scripts') %>
</body>
</html>
