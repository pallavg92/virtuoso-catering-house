.ty__rule{height:1px;width:56px;background:var(--brand-accent);margin-bottom:var(--space-5)}
.ty__title{font-family:var(--font-display);font-weight:var(--weight-light);font-size:clamp(34px,2.1rem + 1.8vw,54px);line-height:1.12;color:var(--text-primary);margin:0 0 var(--space-4)}
.ty__copy{font-family:var(--font-body);font-weight:300;font-size:clamp(16px,.9rem + .3vw,19px);line-height:1.6;color:var(--text-secondary);margin:0 0 var(--space-7);max-width:52ch}
.ty__steps{list-style:none;margin:0 0 var(--space-7);padding:0;border-top:var(--rule-hairline)}
.ty__step{display:flex;gap:var(--space-4);padding:var(--space-4) 0;border-bottom:var(--rule-hairline)}
.ty__num{font-family:var(--font-body);font-size:var(--text-label);letter-spacing:var(--tracking-label);color:var(--text-secondary);padding-top:3px;min-width:2ch}
.ty__step p{font-family:var(--font-body);font-weight:300;font-size:16px;line-height:1.6;color:var(--text-secondary);margin:0}
.ty__actions{display:flex;flex-wrap:wrap;gap:var(--space-3)}
.ty__foot{margin-top:var(--space-8);padding-top:var(--space-5);border-top:var(--rule-hairline);font-family:var(--font-body);font-size:13px;line-height:1.7;color:var(--text-secondary)}
.ty__foot a{color:inherit}
</style>
</head>
<body>
<main class="ty">
  <div class="ty__inner">
    <p class="ty__eyebrow">Request received</p>
    <div class="ty__rule"></div>
    <h1 class="ty__title">Thank you. Your celebration is with our curator.</h1>
    <p class="ty__copy">
      We have your details. A Virtuoso F&amp;B curator will call you within one working day
      to understand the celebration and show you relevant work.
    </p>

    <ol class="ty__steps">
      <li class="ty__step"><span class="ty__num">01</span><p>Our curator calls to understand the family, the venue and the experience you want your guests to have.</p></li>
      <li class="ty__step"><span class="ty__num">02</span><p>Once the brief and commercial scope are aligned, we develop your first personalised direction within 24 hours.</p></li>
      <li class="ty__step"><span class="ty__num">03</span><p>Selected dishes are tasted, details are refined, and the final experience is prepared for execution.</p></li>
    </ol>

    <div class="ty__actions">
      <a class="btn btn--accent" href="https://wa.me/918700915463?text=Hi%2C%20I%20just%20enquired%20about%20catering%20for%20my%20child%27s%20first%20birthday." target="_blank" rel="noopener">Message us on WhatsApp</a>
      <a class="btn btn--ghost" href="tel:+918700915463">Call +91 87009 15463</a>
    </div>

    <p class="ty__foot">
      Virtuoso Catering House · Sector 61, Noida<br />
      <a href="tel:+918700915463">+91 87009 15463</a>
    </p>
  </div>
</main>

<script>
  /* Conversion fires here, once. sessionStorage stops a refresh or a
     back-button return from counting the same enquiry twice. */
  (function () {
    try {
      if (!sessionStorage.getItem('virtuoso_fb_lead')) {
        sessionStorage.setItem('virtuoso_fb_lead', '1');
        if (typeof fbq === 'function') fbq('track', 'Lead', { content_name: 'First Birthday' });
        if (typeof gtag === 'function') gtag('event', 'generate_lead', { event_type: 'First Birthday' });
      }
    } catch (err) {
      /* Tracking must never break the page. */
    }
  })();
</script>
</body>
</html>
