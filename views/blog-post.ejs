<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
<%- include('partials/head') %>
</head>
<body class="<%= bodyClass %>">

<%- include('partials/preloader') %>
<%- include('partials/cursor') %>
<%- include('partials/nav') %>
<%- include('partials/whatsapp-float') %>

<main id="smooth-wrapper">
<div id="smooth-content">

  <!-- INTRO -->
  <section class="page-intro page-intro--short">
    <div class="page-intro__media" data-parallax>
      <img src="<%= post.image %>" alt="<%= post.title %>" loading="eager">
    </div>
    <div class="page-intro__scrim"></div>
    <div class="page-intro__content container">
      <%- include('partials/breadcrumb') %>
      <% if (post.date) { %>
      <%# <time datetime> gives crawlers an unambiguous ISO date; the visible
          text stays in the reader's format. If post.updated is set it shows
          as well, since a visible update date is worth as much to a reader
          deciding whether to trust the piece as it is to a crawler.
          EJS comment, not HTML: an HTML comment here would ship this note to
          every visitor and every crawler on every post. -%>
      <span class="eyebrow eyebrow--light reveal-up">
        <time datetime="<%= post.date %>"><%= new Date(post.date).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %></time>
        <% if (post.updated && post.updated !== post.date) { %>
        · Updated <time datetime="<%= post.updated %>"><%= new Date(post.updated).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %></time>
        <% } %>
      </span>
      <% } %>
      <h1 class="page-intro__title reveal-up"><%= post.title %></h1>
    </div>
  </section>

  <!-- ARTICLE -->
  <section class="blog-post section section--ivory">
    <div class="container">
      <% if (post.lead) { %>
      <div class="blog-post__prose">
        <% post.lead.forEach(function(paragraph) { %>
        <p class="blog-post__copy blog-post__copy--lead reveal-up"><%- paragraph %></p>
        <% }); %>
      </div>
      <% } %>

      <%# A diagram belongs with the text it explains, not behind a scrim as a
          hero. Sits after the lead so a reader meets the labelled board before
          the five entries that walk through it. -%>
      <% if (post.leadImage) { %>
      <figure class="blog-post__image-break reveal-up">
        <img src="<%= post.leadImage.src %>" alt="<%= post.leadImage.caption %>" loading="lazy">
        <figcaption><%= post.leadImage.caption %></figcaption>
      </figure>
      <% } %>

      <% if (post.body) { %>
      <div class="blog-post__prose">
        <% post.body.forEach(function(paragraph) { %>
        <p class="blog-post__copy reveal-up"><%- paragraph %></p>
        <% }); %>
      </div>
      <% } %>

      <% (post.sections || []).forEach(function(section) { %>
      <div class="blog-post__prose">
        <% if (section.kicker) { %>
        <span class="blog-post__kicker reveal-up"><%= section.kicker %></span>
        <% } %>
        <!-- The style descriptor sits on the heading line rather than above it.
             As a separate tracked-caps label it read as a third disconnected
             fragment stacked over the name, which is not what a numbered list
             entry should look like. -->
        <h2 class="blog-post__heading reveal-up"><%= section.heading %><% if (section.headingNote) { %><span class="blog-post__heading-note"> - <%= section.headingNote %></span><% } %></h2>
        <% if (section.attribution) { %>
        <p class="blog-post__attribution reveal-up"><%= section.attribution %></p>
        <% } %>
        <% section.paragraphs.forEach(function(paragraph) { %>
        <p class="blog-post__copy reveal-up"><%- paragraph %></p>
        <% }); %>
        <% if (section.pullQuote) { %>
        <blockquote class="blog-post__pull-quote reveal-up"><%= section.pullQuote %></blockquote>
        <% } %>
        <% if (section.list && section.list.length) { %>
        <ul class="landing-list">
          <% section.list.forEach(function(item) { %>
          <li class="landing-list__item reveal-up"><%= item %></li>
          <% }); %>
        </ul>
        <% } %>
        <%# Ordered steps, for anything with a method. Distinct from `list`,
            which is unordered: a recipe read out of order is a different
            recipe. -%>
        <% if (section.steps && section.steps.length) { %>
        <ol class="blog-post__steps">
          <% section.steps.forEach(function(step) { %>
          <li class="reveal-up"><%= step %></li>
          <% }); %>
        </ol>
        <% } %>
        <% if (section.outro) { %>
        <p class="blog-post__copy reveal-up"><%= section.outro %></p>
        <% } %>
        <!-- Pairing line. The label is the one place amber sets type on a
             light ground, per the Visual Language System. -->
        <% if (section.pairing) { %>
        <p class="blog-post__pairing-label reveal-up"><%= section.pairing.label %></p>
        <p class="blog-post__pairing reveal-up"><%= section.pairing.items %></p>
        <% } %>
        <% if (section.links && section.links.length) { %>
        <% section.links.forEach(function(link) { %>
        <p class="blog-post__copy reveal-up"><a href="<%= link.path %>" class="link-underline"<% if (/^https?:/.test(link.path)) { %> target="_blank" rel="noopener"<% } %>><%= link.label %></a></p>
        <% }); %>
        <% } %>
      </div>

      <!-- Summary table. Rules only, no vertical borders and no zebra
           striping: the system carries structure with weight, not fill.
           Wrapped so a narrow screen scrolls the table rather than the page. -->
      <% if (section.table) { %>
      <div class="blog-post__table-wrap reveal-up">
        <table class="blog-post__table">
          <thead>
            <tr>
              <% section.table.head.forEach(function(cell) { %>
              <th scope="col"><%= cell %></th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <% section.table.rows.forEach(function(row) { %>
            <tr>
              <% row.forEach(function(cell, ci) { %>
              <% if (ci === 0) { %><th scope="row"><%= cell %></th><% } else { %><td><%= cell %></td><% } %>
              <% }); %>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>

      <% if (section.gallery) { %>
      <div class="blog-post__gallery reveal-up">
        <% section.gallery.images.forEach(function(src) { %>
        <img src="<%= src %>" alt="A grazing table by Virtuoso Catering House at an event in Delhi NCR" loading="lazy">
        <% }); %>
      </div>
      <% if (section.gallery.caption) { %>
      <p class="blog-post__gallery-caption reveal-up"><%= section.gallery.caption %></p>
      <% } %>
      <% } %>

      <% if (section.image) { %>
      <figure class="blog-post__image-break reveal-up">
        <img src="<%= section.image.src %>" alt="<%= section.image.caption %>" loading="lazy">
        <figcaption><%= section.image.caption %></figcaption>
      </figure>
      <% } %>

      <% if (section.images && section.images.length) { %>
      <div class="blog-post__duo reveal-up">
        <% section.images.forEach(function(img) { %>
        <figure>
          <img src="<%= img.src %>" alt="<%= img.caption %>" loading="lazy">
          <figcaption><%= img.caption %></figcaption>
        </figure>
        <% }); %>
      </div>
      <% } %>
      <% }); %>

      <div class="blog-post__prose">
        <% if (post.relatedLink) { %>
        <p class="blog-post__copy reveal-up"><a href="<%= post.relatedLink.path %>" class="link-underline"><%= post.relatedLink.label %></a></p>
        <% } %>
        <!-- Crawlable route to the enquiry page. The CTA banner below opens a
             JavaScript drawer, so without this anchor /contact receives no
             internal link from any Journal post. Per-post copy can override it
             via post.enquiryLink. -->
        <p class="blog-post__copy reveal-up"><a href="<%= (post.enquiryLink && post.enquiryLink.path) || '/contact' %>" class="link-underline"><%= (post.enquiryLink && post.enquiryLink.label) || 'Tell us about your event and start an enquiry' %></a></p>
        <% if (post.backLink) { %>
        <a href="<%= post.backLink.path %>" class="link-underline reveal-up"><%= post.backLink.label %></a>
        <% } else { %>
        <a href="/blog" class="link-underline reveal-up">Back to the Journal</a>
        <% } %>
      </div>
    </div>
  </section>

  <% if (post.faq && post.faq.length) { %>
  <!-- FAQ -->
  <section class="landing-faq section section--ivory">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow reveal-up">Questions</span>
        <h2 class="section-title reveal-up">Frequently Asked Questions</h2>
        <span class="section-header__line"></span>
      </div>
      <div class="landing-faq__list">
        <% post.faq.forEach(function(item) { %>
        <details class="landing-faq__item reveal-up">
          <summary class="landing-faq__question"><%= item.q %></summary>
          <p class="landing-faq__answer"><%= item.a %></p>
        </details>
        <% }); %>
      </div>
    </div>
  </section>

  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": post.faq.map(function(item) {
      return {
        "@type": "Question",
        "name": item.q,
        "acceptedAnswer": {
          "@type": "Answer",
          "text": item.a
        }
      };
    })
  }) %>
  </script>
  <% } %>

  <% if (post.author) { %>
  <!-- AUTHOR -->
  <section class="blog-post-author section section--ivory">
    <div class="container blog-post__prose">
      <span class="eyebrow eyebrow--gold reveal-up">About the Author</span>
      <%# Link the byline to the author's own page. team-member.ejs describes
          this as a two-way relationship, but only the return leg existed: the
          team page listed every article, and no article pointed back. That left
          /team/* with no incoming internal links at all, which is what an
          orphan page is, and it wasted the authorship signal the shared
          Person @id was built to consolidate. -%>
      <% const authorPage = (typeof founders !== 'undefined' ? founders : []).find(function (f) { return f.name === post.author.name; }); %>
      <h3 class="blog-post-author__name reveal-up"><% if (authorPage) { %><a href="/team/<%= authorPage.slug %>" class="link-underline"><%= post.author.name %></a><% } else { %><%= post.author.name %><% } %></h3>
      <p class="blog-post-author__bio reveal-up"><%= post.author.bio %></p>
      <% if (post.author.linkedin) { %>
      <a href="<%= post.author.linkedin %>" target="_blank" rel="noopener" class="link-underline reveal-up">Connect on LinkedIn</a>
      <% } %>
    </div>
  </section>
  <% } %>

  <!-- CTA BANNER -->
  <section class="cta-banner section section--wine">
    <div class="container cta-banner__inner">
      <h2 class="cta-banner__title reveal-up">Planning a Launch<br>of Your Own?</h2>
      <button type="button" class="btn btn--gold-outline" data-magnetic data-inquire-trigger data-cursor="hover"><span>Start an Inquiry</span></button>
    </div>
  </section>

<%- include('partials/footer') %>
</div>
</main>

<%- include('partials/scripts') %>
</body>
</html>
