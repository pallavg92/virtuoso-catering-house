<div class="site-popup site-popup--entry" id="entry-popup" aria-hidden="true">
  <div class="site-popup__overlay" data-popup-dismiss></div>
  <div class="site-popup__panel" role="dialog" aria-modal="true" aria-labelledby="entry-popup-title">
    <button type="button" class="site-popup__close" aria-label="Close" data-popup-dismiss data-cursor="hover">&times;</button>
    <span class="eyebrow eyebrow--gold">Before You Explore</span>
    <h2 id="entry-popup-title" class="site-popup__title">What Brings You<br>to Virtuoso?</h2>
    <p class="site-popup__intro">Tell us what you're planning and we'll tailor the conversation from there.</p>
    <div class="site-popup__options">
      <button type="button" class="site-popup__option" data-inquire-trigger data-event-type="Wedding" data-cursor="hover">Wedding</button>
      <button type="button" class="site-popup__option" data-inquire-trigger data-event-type="Brand" data-cursor="hover">Brand Activation</button>
      <button type="button" class="site-popup__option" data-inquire-trigger data-event-type="Private" data-cursor="hover">Private Celebration</button>
      <button type="button" class="site-popup__option" data-inquire-trigger data-event-type="Other" data-cursor="hover">Something Else</button>
    </div>
    <button type="button" class="site-popup__dismiss" data-popup-dismiss>Not right now</button>
  </div>
</div>

<div class="site-popup site-popup--exit" id="exit-popup" aria-hidden="true">
  <div class="site-popup__overlay" data-popup-dismiss></div>
  <div class="site-popup__panel" role="dialog" aria-modal="true" aria-labelledby="exit-popup-title">
    <button type="button" class="site-popup__close" aria-label="Close" data-popup-dismiss data-cursor="hover">&times;</button>
    <span class="eyebrow eyebrow--gold">Before You Go</span>
    <h2 id="exit-popup-title" class="site-popup__title">Have a Question<br>About Your Event?</h2>
    <p class="site-popup__intro">Skip the form for now — just tell us what you need and our team will get back to you today.</p>
    <div class="site-popup__actions">
      <button type="button" class="btn btn--wine" data-inquire-trigger data-magnetic data-cursor="hover"><span>Start an Inquiry</span></button>
      <a href="https://wa.me/918700915463?text=Hi%2C%20I%27d%20like%20to%20enquire%20about%20catering." class="btn btn--gold-outline" target="_blank" rel="noopener noreferrer" data-magnetic data-cursor="hover"><span>Message on WhatsApp</span></a>
    </div>
    <button type="button" class="site-popup__dismiss" data-popup-dismiss>No thanks, I'll keep browsing</button>
  </div>
</div>

<% if (typeof bodyClass !== 'undefined' && bodyClass === 'page-wedding-menu') { %>
<%#
  Wedding-menu only, and it fires on scroll depth rather than a timer: the
  point is to catch someone who has read far enough to be interested, which a
  clock cannot tell you. Two of the thirty-four stations are held back from
  the page, and until now the only thing that said so was a line of small
  type next to each of them.

  It offers the download, which in turn hands into the enquiry form. See
  public/js/menu-download-drawer.js.
-%>
<div class="site-popup site-popup--scroll" id="menu-scroll-popup" aria-hidden="true">
  <div class="site-popup__overlay" data-popup-dismiss></div>
  <div class="site-popup__panel" role="dialog" aria-modal="true" aria-labelledby="menu-scroll-popup-title">
    <button type="button" class="site-popup__close" aria-label="Close" data-popup-dismiss data-cursor="hover">&times;</button>
    <span class="eyebrow eyebrow--gold">Still Reading</span>
    <h2 id="menu-scroll-popup-title" class="site-popup__title">Like What<br>You're Seeing?</h2>
    <p class="site-popup__intro">Thirty-two dishes are not on this page. The 360&deg; Grazing Experience and the Chef's Edit Bites are in the menu PDF, which downloads once you have given us five details.</p>
    <div class="site-popup__actions">
      <button type="button" class="btn btn--wine" data-menu-download-trigger data-magnetic data-cursor="hover"><span>Download the Menu (PDF)</span></button>
    </div>
    <button type="button" class="site-popup__dismiss" data-popup-dismiss>I'll keep reading</button>
  </div>
</div>
<% } %>
