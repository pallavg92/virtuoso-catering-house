<script>
(function () {
  /* ------------------------------------------------------------------
     CRM HOOK
     Set LEAD_ENDPOINT to your CRM / webhook URL. The form POSTs JSON
     using the same field names as the first-birthday lander:
     { name, phone, email, partyType, eventDate, guestCount, eventVision,
       budgetConfirmed, eventType, pageVariant, utm_*, gclid, fbclid,
       page_url, submitted_at }
     While LEAD_ENDPOINT is empty the form shows the thank-you state
     without sending anything (preview mode).
     ------------------------------------------------------------------ */
  // Posts to our own server, which emails the enquiry and reports the
  // Lead to Meta from the server with the same event id the pixel uses
  // below, so Meta counts one conversion rather than two.
  var LEAD_ENDPOINT = "/lp/diwali-2026-plan";
  var PRICE_PER_GUEST = 3500;
  var DIWALI = new Date("2026-11-08T00:00:00+05:30");

  /* Countdown */
  var days = Math.ceil((DIWALI - new Date()) / 86400000);
  var cd = document.getElementById("countdown");
  if (days > 1) cd.textContent = "Diwali is Sunday, 8 November · " + days + " days to plan";
  else if (days === 1) cd.textContent = "Diwali is tomorrow";
  else if (days === 0) cd.textContent = "Happy Diwali";
  else cd.remove();

  /* Party date: any day from today onwards */
  var dateEl = document.getElementById("eventDate");
  var today = new Date(); today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
  dateEl.min = today.toISOString().slice(0, 10);
  /* The offer runs to Diwali itself. */
  var LAST_DATE = "2026-11-08";
  dateEl.max = LAST_DATE;

  /* Capture UTM / click IDs */
  try {
    var qs = new URLSearchParams(location.search);
    ["utm_source","utm_medium","utm_campaign","utm_content","utm_term","gclid","fbclid"].forEach(function (k) {
      var v = qs.get(k); if (v) document.getElementById(k).value = v;
    });
  } catch (e) {}

  /* Validation */
  var form = document.getElementById("lander-form");

  /* Change 3 — one form start per visit. This is the number the ads are
     judged on: how many people the ad actually moved to begin. */
  var startSent = false;
  try { startSent = sessionStorage.getItem("vch_diwali_form_start") === "1"; } catch (e) {}
  form.addEventListener("focusin", function () {
    if (startSent) return;
    startSent = true;
    try { sessionStorage.setItem("vch_diwali_form_start", "1"); } catch (e) {}
    try { fbq("trackCustom", "DiwaliFormStart"); } catch (e) {}
    try { gtag("event", "diwali_form_start"); } catch (e) {}
  });

  /* Change 4 — a host who phones skips the form entirely, so without this
     the call is invisible to Meta. Covers all four tel: links. */
  document.addEventListener("click", function (ev) {
    var tel = ev.target.closest && ev.target.closest('a[href^="tel:"]');
    if (!tel) return;
    try { fbq("track", "Contact", { content_name: "Diwali 2026" }); } catch (e) {}
    try { gtag("event", "phone_click", { event_category: "diwali_2026" }); } catch (e) {}
  });
  function setErr(wrapId, errId, msg) {
    document.getElementById(wrapId).classList.toggle("invalid", !!msg);
    document.getElementById(errId).textContent = msg || "";
    return !msg;
  }
  function validate() {
    var ok = true, first = null;
    function check(cond, wrapId, errId, msg, el) {
      if (!setErr(wrapId, errId, cond ? "" : msg)) { ok = false; if (!first) first = el; }
    }
    var name = document.getElementById("name");
    check(name.value.trim().length > 1, "f-name", "name-err", "Enter your name.", name);
    var phone = document.getElementById("phone");
    var digits = phone.value.replace(/\D/g, "").replace(/^(91|0)(?=\d{10}$)/, "");
    check(/^[6-9]\d{9}$/.test(digits), "f-phone", "phone-err", "Enter a 10-digit mobile number.", phone);
    check(!!form.querySelector('input[name="partyType"]:checked'), "f-type", "type-err", "Choose corporate or private.", document.getElementById("type-office"));
    check(!!dateEl.value && dateEl.value >= dateEl.min, "f-date", "date-err", "Choose the date of your party.", dateEl);
    var guests = document.getElementById("guestCount");
    check(!!guests.value, "f-guests", "guest-err", "Choose how many guests you expect.", guests);
    var email = document.getElementById("email");
    check(/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email.value.trim()), "f-email", "email-err", "Enter your email address.", email);
    var place = document.getElementById("eventLocation");
    check(place.value.trim().length > 1, "f-location", "location-err", "Tell us where the party is.", place);
    var ack = document.getElementById("budgetConfirmed");
    check(ack.checked, "f-ack", "ack-err", "Please confirm the pricing to check your date.", ack);
    if (first) first.focus();
    return ok;
  }

  form.addEventListener("submit", function (ev) {
    ev.preventDefault();
    document.getElementById("lander-status").textContent = "";
    if (!validate()) return;

    var data = {};
    new FormData(form).forEach(function (v, k) { data[k] = typeof v === "string" ? v.trim() : v; });
    data.phone = "+91" + data.phone.replace(/\D/g, "").replace(/^(91|0)(?=\d{10}$)/, "");
    data.budgetConfirmed = "yes";
    data.page_url = location.href;
    data.submitted_at = new Date().toISOString();

    var opt = document.getElementById("guestCount").selectedOptions[0];
    var minGuests = parseInt(opt.getAttribute("data-min"), 10) || 50;

    /* Change 1 — an enquiry with no guest count, or for a date after Diwali,
       is saved and emailed like any other, but it is not reported to Meta as
       a Lead. Those rarely book, and reporting them teaches the ad delivery
       to go looking for more of them. */
    var qualified = data.guestCount !== "Not finalised yet" && data.eventDate <= LAST_DATE;

    var btn = document.getElementById("lander-submit");
    var btnLine = btn.querySelector(".cta-big__line");
    var label = btnLine.innerHTML;
    btn.disabled = true; btnLine.textContent = "Sending…";

    var send = fetch(LEAD_ENDPOINT, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) })
      .then(function (r) {
        if (!r.ok) throw new Error(r.status);
        return r.json().catch(function () { return {}; });
      })
      .then(function (body) {
        if (body && body.ok === false) throw new Error("rejected");
        return body || {};
      });

    send.then(function (body) {
      window.dispatchEvent(new CustomEvent("vch:lead", { detail: data }));
      if (qualified) {
        try { fbq("track", "Lead", { content_name: "Diwali 2026", value: minGuests * PRICE_PER_GUEST, currency: "INR" }, body.eventId ? { eventID: body.eventId } : undefined); } catch (e) {}
        try { gtag("event", "generate_lead", { event_category: "diwali_2026", value: minGuests * PRICE_PER_GUEST, currency: "INR" }); } catch (e) {}
      } else {
        /* Counted, so the enquiry is never lost from reporting, but kept out
           of the conversion the ads optimise towards. */
        try { gtag("event", "diwali_enquiry_unqualified", { event_category: "diwali_2026" }); } catch (e) {}
      }
      var firstName = data.name.split(/\s+/)[0];
      document.getElementById("done-title").textContent = "Thank you, " + firstName + ". Your plan is on its way.";
      var dateText = new Date(data.eventDate + "T12:00:00").toLocaleDateString("en-IN", { weekday: "short", day: "numeric", month: "short" });
      document.getElementById("done-text").textContent = "Our representative will call you now on " +
        data.phone.replace(/^\+91(\d{5})(\d{5})$/, "+91 $1 $2") + " to confirm " +
        dateText + " and the size of the party. Your written plan follows within 24 hours of that call.";
      document.getElementById("form-view").hidden = true;
      var done = document.getElementById("done-view");
      done.hidden = false; done.focus();
    }).catch(function () {
      document.getElementById("lander-status").textContent = "We couldn't send your enquiry. Check your connection and try again, or call +91 87009 15463.";
    }).finally(function () {
      btn.disabled = false; btnLine.innerHTML = label;
    });
  });

  document.getElementById("again").addEventListener("click", function () {
    form.reset();
    document.getElementById("done-view").hidden = true;
    document.getElementById("form-view").hidden = false;
    document.getElementById("name").focus();
  });

  /* The hero film. Same rules as the counter film below: nothing downloads
     for reduced motion or data saver, and it pauses once it scrolls away. */
  var heroFilm = document.querySelector("[data-hero-film]");
  var motionOk = !window.matchMedia("(prefers-reduced-motion: reduce)").matches &&
    !((navigator.connection || {}).saveData);
  if (heroFilm && motionOk) {
    heroFilm.addEventListener("canplay", function () { heroFilm.classList.add("is-ready"); }, { once: true });
    Array.prototype.forEach.call(heroFilm.querySelectorAll("source[data-src]"), function (src) {
      src.src = src.getAttribute("data-src");
    });
    heroFilm.load();
    var heroPlay = function () {
      var r = heroFilm.play();
      if (r && typeof r.catch === "function") r.catch(function () {});
    };
    heroPlay();
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { e.isIntersecting ? heroPlay() : heroFilm.pause(); });
      }, { threshold: 0 }).observe(heroFilm);
    }
  }

  /* The film band under the hero. Same rules as the counter film below. */
  var reel = document.querySelector("[data-reel-film]");
  var reelVideo = reel && reel.querySelector("video");
  if (reelVideo && motionOk && "IntersectionObserver" in window) {
    var reelStarted = false;
    new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) { if (reelStarted) reelVideo.pause(); return; }
        if (!reelStarted) {
          reelStarted = true;
          reelVideo.addEventListener("canplay", function () { reelVideo.classList.add("is-ready"); }, { once: true });
          Array.prototype.forEach.call(reelVideo.querySelectorAll("source[data-src]"), function (src) {
            src.src = src.getAttribute("data-src");
          });
          reelVideo.load();
        }
        var r = reelVideo.play();
        if (r && typeof r.catch === "function") r.catch(function () {});
      });
    }, { threshold: 0.25 }).observe(reel);
  }

  /* The team film, under the list of what is included. */
  var team = document.querySelector("[data-team-film]");
  var teamVideo = team && team.querySelector("video");
  if (teamVideo && motionOk && "IntersectionObserver" in window) {
    var teamStarted = false;
    new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) { if (teamStarted) teamVideo.pause(); return; }
        if (!teamStarted) {
          teamStarted = true;
          teamVideo.addEventListener("canplay", function () { teamVideo.classList.add("is-ready"); }, { once: true });
          Array.prototype.forEach.call(teamVideo.querySelectorAll("source[data-src]"), function (src) {
            src.src = src.getAttribute("data-src");
          });
          teamVideo.load();
        }
        var t = teamVideo.play();
        if (t && typeof t.catch === "function") t.catch(function () {});
      });
    }, { threshold: 0.25 }).observe(team);
  }

  /* The setup film. Nothing downloads until it is on screen, so a visitor
     who never scrolls that far never pays for it. Skipped entirely for
     reduced motion and data saver, where the still photograph is the page. */
  var setup = document.querySelector("[data-setup-film]");
  var setupVideo = setup && setup.querySelector("video");
  if (setupVideo && motionOk && "IntersectionObserver" in window) {
    var setupStarted = false;
    new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (!entry.isIntersecting) { if (setupStarted) setupVideo.pause(); return; }
        if (!setupStarted) {
          setupStarted = true;
          setupVideo.addEventListener("canplay", function () { setupVideo.classList.add("is-ready"); }, { once: true });
          Array.prototype.forEach.call(setupVideo.querySelectorAll("source[data-src]"), function (src) {
            src.src = src.getAttribute("data-src");
          });
          setupVideo.load();
        }
        var u = setupVideo.play();
        if (u && typeof u.catch === "function") u.catch(function () {});
      });
    }, { threshold: 0.25 }).observe(setup);
  }

  /* Hide the mobile bar while the form is on screen */
  var bar = document.getElementById("mbar");
  if ("IntersectionObserver" in window) {
    new IntersectionObserver(function (es) {
      es.forEach(function (e) { bar.classList.toggle("away", e.isIntersecting); });
    }, { threshold: 0.1 }).observe(form);
  }
})();
</script>

</body>
</html>
