<!DOCTYPE html>
<html lang="en" class="no-js">
<head>
<%- include('partials/head') %>
</head>
<body class="<%= bodyClass %>">

<%- include('partials/preloader') %>
<%- include('partials/cursor') %>
<%- include('partials/nav') %>
<%- include('partials/whatsapp-float') %>
<%- include('partials/popups') %>

<main id="smooth-wrapper">
<div id="smooth-content">

  <!-- INTRO -->
  <section class="page-intro">
    <div class="page-intro__media" data-parallax>
      <img src="<%= aboutHeroImage %>" alt="A candlelit plated dish by Virtuoso Catering House" loading="eager">
    </div>
    <div class="page-intro__scrim"></div>
    <div class="page-intro__content container">
      <%- include('partials/breadcrumb') %>
      <span class="eyebrow eyebrow--light reveal-up">About Virtuoso Catering House</span>
      <h1 class="page-intro__title reveal-up">Where Every Detail<br>Becomes the Experience</h1>
    </div>
  </section>

  <!-- WHO WE ARE. Sits above the founders because a reader arriving here wants
       to know what the business is before who runs it. -->
  <section class="section section--ivory">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow reveal-up">Who We Are</span>
        <h2 class="section-title reveal-up"><%= aboutPage.intro.heading %></h2>
        <span class="section-header__line"></span>
      </div>
      <div class="blog-post__prose">
        <% aboutPage.intro.paragraphs.forEach(function(p, i) { %>
        <p class="blog-post__copy <%= i === 0 ? 'blog-post__copy--lead' : '' %> reveal-up"><%= p %></p>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- THE HOUSE STANDARD -->
  <section class="section section--charcoal">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow eyebrow--light reveal-up">How We Hold the Line</span>
        <h2 class="section-title reveal-up"><%= aboutPage.standard.heading %></h2>
        <span class="section-header__line"></span>
      </div>
      <div class="blog-post__prose">
        <p class="blog-post__copy blog-post__copy--lead reveal-up"><%= aboutPage.standard.intro %></p>
      </div>
      <div class="landing-cards landing-cards--compact">
        <% aboutPage.standard.items.forEach(function(item) { %>
        <div class="landing-card reveal-up">
          <h3 class="landing-card__title landing-card__title--gold"><%= item.title %></h3>
          <ul class="landing-card__list">
            <li><%= item.copy %></li>
          </ul>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- CLIENTS -->
  <section class="section section--ivory">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow reveal-up">Selected Work</span>
        <h2 class="section-title reveal-up"><%= aboutPage.clients.heading %></h2>
        <span class="section-header__line"></span>
      </div>
      <div class="blog-post__prose">
        <p class="blog-post__copy reveal-up"><%= aboutPage.clients.intro %></p>
        <ul class="landing-list">
          <% aboutPage.clients.items.forEach(function(item) { %>
          <li class="landing-list__item reveal-up"><%= item %></li>
          <% }); %>
        </ul>
        <p class="blog-post__copy reveal-up"><%= aboutPage.clients.outro %></p>
        <p class="blog-post__copy reveal-up"><a href="/our-work" class="link-underline">See the work in full</a></p>
      </div>
    </div>
  </section>

  <!-- FOUNDERS -->
  <section class="founders section section--ivory">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow reveal-up">The Founders</span>
        <h2 class="section-title reveal-up">Aarti Sharma &amp; Pallav Goel</h2>
        <span class="section-header__line"></span>
      </div>

      <div class="founders__grid">
        <% founders.forEach(function(founder) { %>
        <div class="founder-block reveal-up">
          <div class="founder-block__image">
            <img src="<%= founder.image %>" alt="<%= founder.name %>, <%= founder.role %> of Virtuoso Catering House" loading="lazy">
          </div>
          <span class="eyebrow eyebrow--gold"><%= founder.role %></span>
          <h3 class="founder-block__name"><%= founder.name %></h3>
          <p class="founder-block__bio"><%= founder.bio %></p>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- Same @id as the node published on /team/{slug}, so these two pages
       describe one entity rather than two competing ones. `url` points at
       the team page because that is the canonical home for the person. -->
  <% founders.forEach(function(founder) { %>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": siteUrl + '/team/' + founder.slug + '#person',
    "name": founder.name,
    "jobTitle": founder.role,
    "description": founder.bio,
    "image": siteUrl + founder.image,
    "url": siteUrl + '/team/' + founder.slug,
    "knowsAbout": founder.knowsAbout,
    "worksFor": { "@id": siteUrl + '/#organization' },
    "sameAs": [founder.linkedin]
  }) %>
  </script>
  <% }); %>

  <!-- HOW WE WORK -->
  <section class="timeline section section--charcoal">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow eyebrow--light reveal-up">How We Work</span>
        <h2 class="section-title reveal-up">From Brief to Final Night</h2>
        <span class="section-header__line"></span>
      </div>

      <div class="timeline__list" id="timeline-list">
        <div class="timeline__progress" id="timeline-progress"></div>
        <% process.forEach(function(item, i) { %>
        <div class="timeline__item reveal-up">
          <span class="timeline__year"><%= item.step %></span>
          <div class="timeline__dot"></div>
          <div class="timeline__body">
            <h3><%= item.title %></h3>
            <p><%= item.copy %></p>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- REACH + LICENSING. Both are things a reader checking whether we are a
       real operator will look for, and neither existed on this page before. -->
  <section class="section section--ivory">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow reveal-up">Coverage</span>
        <h2 class="section-title reveal-up"><%= aboutPage.reach.heading %></h2>
        <span class="section-header__line"></span>
      </div>
      <div class="blog-post__prose">
        <% aboutPage.reach.paragraphs.forEach(function(p) { %>
        <p class="blog-post__copy reveal-up"><%= p %></p>
        <% }); %>
        <p class="blog-post__copy reveal-up">
          <a href="/wedding-caterers-in-noida" class="link-underline">Wedding caterers in Noida</a> ·
          <a href="/wedding-caterers-in-delhi" class="link-underline">Wedding caterers in Delhi</a> ·
          <a href="/catering-services-in-greater-noida" class="link-underline">Catering in Greater Noida</a>
        </p>
      </div>
    </div>
  </section>

  <section class="section section--ivory">
    <div class="container">
      <div class="section-header">
        <span class="eyebrow reveal-up">Standards</span>
        <h2 class="section-title reveal-up"><%= aboutPage.safety.heading %></h2>
        <span class="section-header__line"></span>
      </div>
      <div class="blog-post__prose">
        <% aboutPage.safety.paragraphs.forEach(function(p) { %>
        <p class="blog-post__copy reveal-up"><%= p %></p>
        <% }); %>
      </div>
    </div>
  </section>

  <!-- CTA BANNER -->
  <section class="cta-banner section section--wine">
    <div class="container cta-banner__inner">
      <h2 class="cta-banner__title reveal-up">Ready to Start<br>the Conversation?</h2>
      <button type="button" class="btn btn--gold-outline" data-magnetic data-inquire-trigger data-cursor="hover"><span>Start an Inquiry</span></button>
    </div>
  </section>

<%- include('partials/footer') %>
</div>
</main>

<%- include('partials/scripts') %>
</body>
</html>
